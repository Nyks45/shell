#!/usr/bin/python3 -I
"""Caelestia settings: changes this user's password (sign-in and screen lock).

The new password comes on stdin (never on a command line). It is hashed here
(SHA-512 crypt, like passwd) and handed to AccountsService, which asks polkit
first: the shell's password prompt, for the current password.
"""

import os
import pwd
import subprocess
import sys

from gi.repository import Gio, GLib


def main():
    password = sys.stdin.readline().rstrip("\n")
    if not password or "\n" in password:
        print("No password given", file=sys.stderr)
        return 2
    hashed = subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=password + "\n", text=True,
                            stdout=subprocess.PIPE, check=True).stdout.strip()
    if not hashed.startswith("$6$"):
        print("Couldn't hash the password", file=sys.stderr)
        return 1
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    user = pwd.getpwuid(os.getuid()).pw_name
    path = bus.call_sync("org.freedesktop.Accounts", "/org/freedesktop/Accounts", "org.freedesktop.Accounts",
                         "FindUserByName", GLib.Variant("(s)", (user,)), GLib.VariantType("(o)"),
                         Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
    try:
        bus.call_sync("org.freedesktop.Accounts", path, "org.freedesktop.Accounts.User", "SetPassword",
                      GLib.Variant("(ss)", (hashed, "")), None,
                      Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 120000, None)
    except GLib.Error as e:
        msg = Gio.DBusError.get_remote_error(e) or ""
        if "NotAuthorized" in msg or "PermissionDenied" in msg:
            print("Not allowed: the password prompt was closed or the password was wrong", file=sys.stderr)
            return 126
        print(e.message, file=sys.stderr)
        return 1
    print("Password changed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
