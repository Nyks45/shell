#!/usr/bin/python3 -I
"""Caelestia settings: changes this user's password (sign-in, lock, and keyring).

Reads a single-line JSON object {"current": "...", "new": "..."} on stdin
(never on a command line). Changes the Linux password via PAM (passwd in a
pseudo-terminal, using system yescrypt settings cleanly with a single prompt),
then updates the GNOME Keyring login collection master password to match so
saved passwords keep unlocking automatically.
"""

import ctypes
import json
import os
import pty
import select
import signal
import subprocess
import sys
import time

from gi.repository import Gio, GLib


def test_yescrypt(password):
    lib = ctypes.CDLL("libcrypt.so.2")
    lib.crypt_gensalt_rn.argtypes = [ctypes.c_char_p, ctypes.c_ulong, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
    lib.crypt_gensalt_rn.restype = ctypes.c_char_p
    lib.crypt_r.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p]
    lib.crypt_r.restype = ctypes.c_char_p
    salt = ctypes.create_string_buffer(256)
    if not lib.crypt_gensalt_rn(b"$y$", 0, None, 0, salt, 256):
        raise RuntimeError("crypt_gensalt_rn failed")
    data = ctypes.create_string_buffer(65536)
    out = lib.crypt_r(password.encode("utf-8"), salt.value, data)
    if not out:
        raise RuntimeError("crypt_r failed")
    h = out.decode("ascii")
    if not h.startswith("$y$"):
        raise RuntimeError("unexpected hash format")
    return h


def parse_input():
    line = sys.stdin.readline().rstrip("\r\n")
    if not line:
        raise ValueError("No password payload given.")
    try:
        data = json.loads(line)
    except ValueError:
        raise ValueError("Invalid password payload.")
    if not isinstance(data, dict):
        raise ValueError("Invalid password payload.")
    current = data.get("current", "")
    new = data.get("new", "")
    if not isinstance(current, str) or not isinstance(new, str):
        raise ValueError("Both current and new passwords are required.")
    if not current or not new:
        raise ValueError("Both current and new passwords are required.")
    for pw in (current, new):
        if "\n" in pw or "\r" in pw or "\x00" in pw:
            raise ValueError("Passwords cannot contain line breaks.")
    if current == new:
        raise ValueError("New password must be different from the current password.")
    return current, new


def summarize_passwd_error(raw_output):
    low = raw_output.lower()
    if any(k in low for k in ("authentication token manipulation", "incorrect", "authentication failure", "wrong password")):
        return "The current password wasn't right."
    for line in raw_output.splitlines():
        s = line.strip()
        sl = s.lower()
        if any(k in sl for k in ("bad password:", "too short", "too simple", "too similar", "unchanged", "palindrome", "wrapped", "dictionary", "fails the dictionary")):
            s = s.replace("BAD PASSWORD:", "").replace("passwd:", "").strip()
            return s[0].upper() + s[1:] if s else "That new password wasn't accepted by the system policy."
    lines = [l.strip() for l in raw_output.splitlines() if l.strip() and "password:" not in l.lower()]
    if lines:
        msg = lines[-1].replace("passwd:", "").strip()
        if msg:
            return msg
    return "Couldn't change the sign-in password."


def run_passwd_pty(current, new):
    passwd_bin = os.environ.get("CAELESTIA_PASSWD_BIN") or "/usr/bin/passwd"
    env = dict(os.environ, LC_ALL="C.UTF-8", LANG="C.UTF-8")
    env.pop("DISPLAY", None)

    master_fd, slave_fd = pty.openpty()
    proc = subprocess.Popen(
        [passwd_bin],
        stdin=slave_fd,
        stdout=slave_fd,
        stderr=slave_fd,
        env=env,
        preexec_fn=os.setsid,
        close_fds=True,
    )
    os.close(slave_fd)

    buf = ""
    scan_pos = 0
    sent_current = False
    sent_new = False
    sent_retype = False
    aborted_reason = None
    deadline = time.monotonic() + 15.0

    def terminate_child():
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except OSError:
            pass

    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                terminate_child()
                aborted_reason = "Password change timed out."
                break

            rlist, _, _ = select.select([master_fd], [], [], min(0.5, remaining))
            if rlist:
                try:
                    chunk = os.read(master_fd, 4096)
                except OSError:
                    chunk = b""
                if not chunk:
                    break
                buf += chunk.decode("utf-8", errors="replace")
                tail = buf[scan_pos:].lower()

                if "current password:" in tail or "(current) unix password:" in tail:
                    if not sent_current:
                        os.write(master_fd, (current + "\n").encode("utf-8"))
                        sent_current = True
                        scan_pos = len(buf)
                    else:
                        terminate_child()
                        aborted_reason = "The current password wasn't right."
                        break
                elif "retype new password:" in tail:
                    if not sent_retype:
                        os.write(master_fd, (new + "\n").encode("utf-8"))
                        sent_retype = True
                        scan_pos = len(buf)
                    else:
                        terminate_child()
                        aborted_reason = "The new passwords didn't match."
                        break
                elif "new password:" in tail:
                    if not sent_new:
                        os.write(master_fd, (new + "\n").encode("utf-8"))
                        sent_new = True
                        scan_pos = len(buf)
                    else:
                        terminate_child()
                        aborted_reason = summarize_passwd_error(buf)
                        break
            elif proc.poll() is not None:
                # Drain any remaining buffered pty data before breaking.
                while True:
                    r2, _, _ = select.select([master_fd], [], [], 0.05)
                    if not r2:
                        break
                    try:
                        chunk = os.read(master_fd, 4096)
                    except OSError:
                        break
                    if not chunk:
                        break
                    buf += chunk.decode("utf-8", errors="replace")
                break
    finally:
        try:
            os.close(master_fd)
        except OSError:
            pass

    rc = proc.wait(timeout=5)
    if aborted_reason:
        return False, aborted_reason
    if rc != 0:
        return False, summarize_passwd_error(buf)
    return True, ""


def sync_keyring(current, new):
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        login_path = bus.call_sync(
            "org.freedesktop.secrets",
            "/org/freedesktop/secrets",
            "org.freedesktop.Secret.Service",
            "ReadAlias",
            GLib.Variant("(s)", ("login",)),
            GLib.VariantType("(o)"),
            Gio.DBusCallFlags.NONE,
            5000,
            None,
        ).unpack()[0]
        if not login_path or login_path == "/":
            return True, ""
        _, session_path = bus.call_sync(
            "org.freedesktop.secrets",
            "/org/freedesktop/secrets",
            "org.freedesktop.Secret.Service",
            "OpenSession",
            GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))),
            GLib.VariantType("(vo)"),
            Gio.DBusCallFlags.NONE,
            5000,
            None,
        ).unpack()
        try:
            cur_secret = (session_path, b"", current.encode("utf-8"), "text/plain")
            new_secret = (session_path, b"", new.encode("utf-8"), "text/plain")
            bus.call_sync(
                "org.freedesktop.secrets",
                "/org/freedesktop/secrets",
                "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface",
                "ChangeWithMasterPassword",
                GLib.Variant("(o(oayays)(oayays))", (login_path, cur_secret, new_secret)),
                None,
                Gio.DBusCallFlags.NONE,
                15000,
                None,
            )
            return True, ""
        finally:
            try:
                bus.call_sync(
                    "org.freedesktop.secrets",
                    session_path,
                    "org.freedesktop.Secret.Session",
                    "Close",
                    None,
                    None,
                    Gio.DBusCallFlags.NONE,
                    2000,
                    None,
                )
            except GLib.Error:
                pass
    except GLib.Error:
        return False, (
            "KEYRING_WARN: Your sign-in password changed, but your saved-passwords keyring "
            "had a different password. Unlock it once with your previous password or update it in Passwords and Keys."
        )


def dry_run_check():
    try:
        current, new = parse_input()
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 2
    yescrypt_sample = test_yescrypt(new)
    login_path = ""
    session_ok = False
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        login_path = bus.call_sync(
            "org.freedesktop.secrets",
            "/org/freedesktop/secrets",
            "org.freedesktop.Secret.Service",
            "ReadAlias",
            GLib.Variant("(s)", ("login",)),
            GLib.VariantType("(o)"),
            Gio.DBusCallFlags.NONE,
            5000,
            None,
        ).unpack()[0]
        if login_path and login_path != "/":
            _, session_path = bus.call_sync(
                "org.freedesktop.secrets",
                "/org/freedesktop/secrets",
                "org.freedesktop.Secret.Service",
                "OpenSession",
                GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))),
                GLib.VariantType("(vo)"),
                Gio.DBusCallFlags.NONE,
                5000,
                None,
            ).unpack()
            session_ok = bool(session_path)
            bus.call_sync(
                "org.freedesktop.secrets",
                session_path,
                "org.freedesktop.Secret.Session",
                "Close",
                None,
                None,
                Gio.DBusCallFlags.NONE,
                2000,
                None,
            )
    except GLib.Error:
        pass
    print(json.dumps({
        "dryRun": True,
        "validInput": True,
        "yescryptPrefix": yescrypt_sample[:7],
        "loginKeyring": login_path,
        "keyringSession": session_ok,
    }))
    return 0


def main():
    if sys.argv[1:2] == ["--dry-run"]:
        return dry_run_check()
    try:
        current, new = parse_input()
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 2

    ok, err = run_passwd_pty(current, new)
    if not ok:
        print(err, file=sys.stderr)
        return 1

    kr_ok, kr_warn = sync_keyring(current, new)
    if not kr_ok and kr_warn:
        print(kr_warn)
    else:
        print("Password and saved-passwords keyring updated")
    return 0


if __name__ == "__main__":
    sys.exit(main())
