#!/usr/bin/python3 -I
"""Caelestia settings: services, scheduled tasks, logs, crash reports and
users, read as JSON for the settings app (runs as the user).

    caelestia-system units [--user]          services: state, enabled, description
    caelestia-system unit NAME [--user]      one service's details
    caelestia-system timers [--user]         scheduled tasks: next/last run
    caelestia-system logs [--boot N] [--priority P] [--unit U] [--grep TEXT] [--lines N] [--user]
    caelestia-system boots                   the recorded boots
    caelestia-system crashes                 crash reports (coredumpctl)
    caelestia-system crash PID               one crash report as text (for bug reports)
    caelestia-system users                   people's accounts and the groups they can join
    caelestia-system user-add NAME FULLNAME admin|standard   (password on stdin)
    caelestia-system user-delete NAME [--remove-files]
    caelestia-system user-type NAME admin|standard
    caelestia-system user-password NAME      (password on stdin)
    caelestia-system boot                    the boot menu (rEFInd) as it shows, for the preview
    caelestia-system kernels                 installed kernels and the ones to install
    caelestia-system firmware                UEFI boot entries, Secure Boot, firmware updates
    caelestia-system fwupd [--refresh]       updatable devices and available firmware updates
    caelestia-system storage-overview        byte totals by category (apps, games, caches, logs, snapshots)
    caelestia-system locales                 system language, regional format, enabled & available locales
    caelestia-system security-status         firewall, Secure Boot / sbctl, TPM, LUKS, portal permissions

Changes go through AccountsService, which asks polkit (the shell's prompt);
starting/stopping services is plain systemctl (polkit too); group
memberships go through the root helper (caelestia-admin group-member).
"""

import concurrent.futures as cf
import ctypes
import glob
import grp
import html
import json
import os
import pwd
import re
import subprocess
import sys
import time

from gi.repository import Gio, GLib


def sh(*cmd):
    p = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return p.stdout


def scope(args):
    return ["--user"] if "--user" in args else []


# --- services ----------------------------------------------------------------

def c_units(args):
    s = scope(args)
    with cf.ThreadPoolExecutor(2) as ex:
        f_u = ex.submit(sh, "systemctl", *s, "list-units", "--type=service", "--all", "-o", "json")
        f_f = ex.submit(sh, "systemctl", *s, "list-unit-files", "--type=service", "-o", "json")
        units_raw = f_u.result()
        files_raw = f_f.result()
    units = {u["unit"]: u for u in json.loads(units_raw or "[]")}
    files = {f["unit_file"]: f["state"] for f in json.loads(files_raw or "[]")}
    out = []
    for name in sorted(set(units) | set(files)):
        if name.endswith("@.service") and name not in units:
            continue  # templates: their instances show instead
        u = units.get(name, {})
        out.append({"name": name, "description": u.get("description", ""), "load": u.get("load", ""),
                    "active": u.get("active", "inactive"), "sub": u.get("sub", "dead"),
                    "enabled": files.get(name, files.get(re.sub(r"@[^.]+\.", "@.", name), ""))})
    print(json.dumps(out))


PROPS = ["Id", "Description", "LoadState", "ActiveState", "SubState", "UnitFileState", "UnitFilePreset",
         "FragmentPath", "MainPID", "MemoryCurrent", "CPUUsageNSec", "ActiveEnterTimestamp",
         "InactiveEnterTimestamp", "ExecMainStartTimestamp", "Restart", "Type", "User", "Documentation",
         "TriggeredBy", "Wants", "After", "Result", "NRestarts", "CanStart", "CanStop", "CanReload"]


def c_unit(args):
    name = args[0]
    s = scope(args[1:])
    out = {}
    for line in sh("systemctl", *s, "show", name, "-p", ",".join(PROPS)).splitlines():
        k, _, v = line.partition("=")
        out[k] = v
    # time and message only (the date, host and process are the same on every line)
    lines = []
    for line in sh("journalctl", *s, "-u" if not s else "--user-unit", name, "-n", "40", "-o", "json", "--no-pager").splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE", "")
        if isinstance(msg, list):
            msg = bytes(x for x in msg if isinstance(x, int)).decode(errors="replace")
        t = int(e.get("__REALTIME_TIMESTAMP", 0)) // 1000000
        lines.append(time.strftime("%d %b %H:%M:%S", time.localtime(t)) + "  " + msg)
    out["log"] = lines[-40:]
    print(json.dumps(out))


def fetch_timers(s):
    with cf.ThreadPoolExecutor(3) as ex:
        f_t = ex.submit(sh, "systemctl", *s, "list-timers", "--all", "-o", "json")
        f_f = ex.submit(sh, "systemctl", *s, "list-unit-files", "--type=timer", "-o", "json")
        f_u = ex.submit(sh, "systemctl", *s, "list-units", "--type=timer", "--all", "-o", "json")
        timers = json.loads(f_t.result() or "[]")
        files = {f["unit_file"]: f["state"] for f in json.loads(f_f.result() or "[]")}
        units = {u["unit"]: u.get("description", "") for u in json.loads(f_u.result() or "[]")}
    missing = [t["unit"] for t in timers if units.get(t["unit"]) is None]
    if missing:
        cur_id, cur_desc = "", ""
        for line in sh("systemctl", *s, "show", *missing, "--property=Id,Description").splitlines():
            if line.startswith("Id="):
                cur_id = line[3:].strip()
            elif line.startswith("Description="):
                cur_desc = line[12:].strip()
                if cur_id:
                    units[cur_id] = cur_desc
    is_user = bool(s)
    for t in timers:
        t["enabled"] = files.get(t["unit"], "")
        t["description"] = units.get(t["unit"], "")
        t["user"] = is_user
    return timers


def c_timers(args):
    if "--all-scopes" in args:
        with cf.ThreadPoolExecutor(2) as ex:
            fs = ex.submit(fetch_timers, [])
            fu = ex.submit(fetch_timers, ["--user"])
            timers = fs.result() + fu.result()
        timers.sort(key=lambda t: (t.get("next") or 0, t.get("unit") or ""))
    else:
        timers = fetch_timers(scope(args))
    print(json.dumps(timers))


# --- logs ---------------------------------------------------------------------

PRIORITY = {"0": "emerg", "1": "alert", "2": "crit", "3": "err", "4": "warning", "5": "notice", "6": "info", "7": "debug"}


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def c_logs(args):
    cmd = ["journalctl", "-o", "json", "--no-pager", "-n", opt(args, "--lines", "400")]
    if "--user" in args:
        cmd.append("--user")
    boot = opt(args, "--boot", "0")
    cmd += ["-b", boot]
    pri = opt(args, "--priority")
    if pri:
        if not re.fullmatch(r"[0-7]", pri):
            sys.exit("bad priority")
        cmd += ["-p", pri]
    unit = opt(args, "--unit")
    if unit:
        cmd += ["-u", unit]
    text = opt(args, "--grep")
    if text:
        cmd += ["--case-sensitive=false", "-g", re.escape(text)]
    out = []
    for line in sh(*cmd).splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE", "")
        if isinstance(msg, list):  # binary messages come as byte arrays
            msg = bytes(x for x in msg if isinstance(x, int)).decode(errors="replace")
        out.append({"time": int(e.get("__REALTIME_TIMESTAMP", 0)) // 1000, "priority": int(e.get("PRIORITY", 6)),
                    "unit": e.get("_SYSTEMD_UNIT") or e.get("_SYSTEMD_USER_UNIT") or "",
                    "ident": e.get("SYSLOG_IDENTIFIER") or e.get("_COMM") or "",
                    "message": msg[:2000]})
    out.reverse()  # newest first
    print(json.dumps(out))


def c_boots(args):
    print(sh("journalctl", "--list-boots", "-o", "json") or "[]")


def c_crashes(args):
    try:
        items = json.loads(sh("coredumpctl", "list", "--json=short", "--no-pager") or "[]")
    except ValueError:
        items = []
    items.sort(key=lambda c: -c.get("time", 0))
    print(json.dumps(items[:200]))


def c_crash(args):
    if not args or not args[0].isdigit():
        sys.exit("crash PID")
    print(sh("coredumpctl", "info", "--no-pager", args[0]))


# --- users ---------------------------------------------------------------------

def c_users(args):
    all_groups = grp.getgrall()
    wheel = next((g for g in all_groups if g.gr_name == "wheel"), None)
    admins = set(wheel.gr_mem) if wheel else set()
    users = []
    for p in pwd.getpwall():
        if 1000 <= p.pw_uid < 60000 and p.pw_shell not in ("/usr/bin/nologin", "/bin/false", "/sbin/nologin"):
            groups = sorted(g.gr_name for g in all_groups if p.pw_name in g.gr_mem)
            users.append({"name": p.pw_name, "uid": p.pw_uid, "fullName": p.pw_gecos.split(",")[0],
                          "home": p.pw_dir, "admin": p.pw_name in admins, "groups": groups,
                          "me": p.pw_uid == os.getuid()})
    # Groups a person may usefully join (hardware and service access), with what they give
    useful = {"wheel": "Administrator (sudo, the password prompt)", "audio": "Sound devices directly",
              "video": "Graphics and camera devices", "input": "Input devices (keyboards, mice, controllers)",
              "storage": "Removable drives", "lp": "Printers", "scanner": "Scanners", "network": "Network settings",
              "i2c": "Monitor brightness over the cable (DDC/CI)", "docker": "Docker containers",
              "libvirt": "Virtual machines", "kvm": "Virtual machine acceleration", "uucp": "Serial ports",
              "rfkill": "Turning radios on and off", "games": "Shared game data", "adm": "Reading all system logs",
              "systemd-journal": "Reading all system logs", "realtime": "Real-time audio priority",
              "gamemode": "GameMode", "plugdev": "Pluggable devices"}
    existing = {g.gr_name for g in all_groups}
    print(json.dumps({"users": users, "groups": [{"name": n, "about": a} for n, a in useful.items() if n in existing]}))


def accounts():
    return Gio.bus_get_sync(Gio.BusType.SYSTEM)


def acc_call(path, iface, method, sig, args, reply=None):
    v = accounts().call_sync("org.freedesktop.Accounts", path, iface, method, GLib.Variant(sig, args),
                             GLib.VariantType(reply) if reply else None,
                             Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 120000, None)
    return v.unpack() if v is not None else None


def user_path(name):
    return acc_call("/org/freedesktop/Accounts", "org.freedesktop.Accounts", "FindUserByName", "(s)", (name,), "(o)")[0]


NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")


def hash_yescrypt(password):
    """Hash a password using libcrypt yescrypt (matching /etc/login.defs)."""
    if not password or "\n" in password or "\r" in password or "\x00" in password:
        sys.exit("no password given")
    try:
        lib = ctypes.CDLL("libcrypt.so.2")
        lib.crypt_gensalt_rn.argtypes = [ctypes.c_char_p, ctypes.c_ulong, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
        lib.crypt_gensalt_rn.restype = ctypes.c_char_p
        lib.crypt_r.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p]
        lib.crypt_r.restype = ctypes.c_char_p
        salt = ctypes.create_string_buffer(256)
        if not lib.crypt_gensalt_rn(b"$y$", 0, None, 0, salt, 256):
            raise OSError("crypt_gensalt_rn failed")
        data = ctypes.create_string_buffer(65536)
        out = lib.crypt_r(password.encode("utf-8"), salt.value, data)
        if not out:
            raise OSError("crypt_r failed")
        h = out.decode("ascii")
        if h.startswith("$y$"):
            return h
    except OSError:
        pass
    return subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=password + "\n", text=True,
                          stdout=subprocess.PIPE, check=True).stdout.strip()


def hashed(password):
    return hash_yescrypt(password)


def c_user_add(args):
    name, full, kind = args[0], args[1], args[2]
    if not NAME.match(name) or kind not in ("admin", "standard"):
        sys.exit("bad name or type")
    pw = sys.stdin.readline().rstrip("\n")
    path = acc_call("/org/freedesktop/Accounts", "org.freedesktop.Accounts", "CreateUser", "(ssi)",
                    (name, full, 1 if kind == "admin" else 0), "(o)")[0]
    if pw:
        acc_call(path, "org.freedesktop.Accounts.User", "SetPassword", "(ss)", (hashed(pw), ""))
    print(path)


def c_user_delete(args):
    name = args[0]
    if pwd.getpwnam(name).pw_uid == os.getuid():
        sys.exit("not your own account")
    acc_call("/org/freedesktop/Accounts", "org.freedesktop.Accounts", "DeleteUser", "(xb)",
             (pwd.getpwnam(name).pw_uid, "--remove-files" in args))


def c_user_type(args):
    name, kind = args[0], args[1]
    if kind not in ("admin", "standard"):
        sys.exit("admin or standard")
    if pwd.getpwnam(name).pw_uid == os.getuid() and kind == "standard":
        sys.exit("you can't take away your own administrator rights here")
    acc_call(user_path(name), "org.freedesktop.Accounts.User", "SetAccountType", "(i)", (1 if kind == "admin" else 0,))


def c_user_password(args):
    acc_call(user_path(args[0]), "org.freedesktop.Accounts.User", "SetPassword", "(ss)",
             (hashed(sys.stdin.readline().rstrip("\n")), ""))


# --- boot ----------------------------------------------------------------------

BOOT_EXPORT = "/var/lib/caelestia/boot"
REFIND_REL = "EFI/refind"
TOOL_ICONS = {"shutdown": "func_shutdown", "reboot": "func_reset", "firmware": "func_firmware", "about": "func_about",
              "exit": "func_exit", "hidden_tags": "func_hidden", "memtest": "tool_memtest", "shell": "tool_shell",
              "gdisk": "tool_part", "netboot": "tool_netboot", "mok_tool": "tool_mok_tool", "bootorder": "func_bootorder",
              "windows_recovery": "tool_windows_rescue", "apple_recovery": "tool_apple_rescue", "fwupdate": "tool_fwupdate",
              "csr_rotate": "func_csr_rotate", "install": "func_install"}


def esp_path(p):
    """A path in refind.conf (from the ESP root, or relative to rEFInd's folder) in the readable copy."""
    p = p.strip().strip('"').replace("\\", "/")
    full = os.path.join(BOOT_EXPORT, p.lstrip("/")) if p.startswith("/") or p.upper().startswith("EFI/") else \
        os.path.join(BOOT_EXPORT, REFIND_REL, p)
    return full if os.path.exists(full) else ""


def parse_refind(path, state, entries, depth=0):
    """Directives in file order (an include in place), menu entries."""
    if depth > 4 or not os.path.exists(path):
        return
    lines = open(path, errors="replace").read().split("\n")
    i = 0
    while i < len(lines):
        bare = lines[i].strip()
        i += 1
        if not bare or bare.startswith("#"):
            continue
        m = re.match(r'^menuentry\s+"?([^"{]+?)"?\s*\{$', bare)
        if m:
            e = {"name": m.group(1).strip(), "submenus": [], "disabled": False, "kernels": []}
            lvl, in_kern = 1, False
            while i < len(lines) and lvl > 0:
                l = lines[i].strip()
                i += 1
                if l.startswith("# hidden in Settings"):
                    e["hiddenBySettings"] = True
                if l.startswith("# BEGIN caelestia-kernels"):
                    in_kern = True
                elif l.startswith("# END caelestia-kernels"):
                    in_kern = False
                if not l or l.startswith("#"):
                    continue
                if l.endswith("{"):
                    lvl += 1
                    sm = re.match(r'^submenuentry\s+"([^"]+)"', l)
                    if sm:
                        (e["kernels"] if in_kern else e["submenus"]).append(sm.group(1))
                    continue
                if l == "}":
                    lvl -= 1
                    continue
                if lvl == 1:
                    k, _, v = l.partition(" ")
                    v = v.strip()
                    if k == "disabled":
                        e["disabled"] = True
                    elif k in ("icon", "loader", "volume", "initrd"):
                        e[k] = v
                    elif k == "options":
                        e["options"] = v.strip('"')
            if not e["disabled"] or e.get("hiddenBySettings"):
                e["iconFile"] = esp_path(e["icon"]) if e.get("icon") else ""
                e["hidden"] = e["disabled"]
                entries.append(e)
            continue
        k, _, v = bare.partition(" ")
        v = v.strip()
        if k == "include":
            parse_refind(os.path.join(BOOT_EXPORT, REFIND_REL, v), state, entries, depth + 1)
        elif k == "showtools" and depth > 0:
            # rEFInd 0.14 adds an included file's tools to the list instead of
            # replacing it (seen: the theme's "shutdown" shows twice)
            state["_includedTools"] = state.get("_includedTools", []) + [w for w in re.split(r"[\s,]+", v) if w]
        else:
            state[k] = v
            state.setdefault("_from", {})[k] = os.path.relpath(path, BOOT_EXPORT)


def c_boot(args):
    conf = os.path.join(BOOT_EXPORT, REFIND_REL, "refind.conf")
    # set up: the watcher keeping this copy current and the kernels hook (boot-setup)
    setup = os.path.exists("/etc/systemd/system/caelestia-boot-export.path") and \
        os.path.exists("/etc/pacman.d/hooks/caelestia-refind-kernels.hook")
    if not os.path.exists(conf):
        print(json.dumps({"exported": False, "setup": setup}))
        return
    state, entries = {}, []
    parse_refind(conf, state, entries)
    words = lambda v: [w for w in re.split(r"[\s,]+", v or "") if w]
    flavour = next((m.group(1) for l in open(conf) if (m := re.match(r"^\s*include\s+themes/catppuccin/(\w+)\.conf", l))), "")
    icons_dir = state.get("icons_dir", "icons")
    # The tools shown: the main file's showtools, or rEFInd's defaults (those
    # it finds: no shell, memtest, gdisk or fwupd tool on this ESP; Windows
    # recovery when Windows is there) followed by any from included files
    if "showtools" in state:
        tool_list = words(state["showtools"])
    else:
        has_windows = any("Microsoft" in (e.get("loader") or "") for e in entries)
        tool_list = (["windows_recovery"] if has_windows else []) + ["about", "hidden_tags", "shutdown", "reboot", "firmware"]
    tool_list += state.get("_includedTools", [])
    tools = []
    for t in tool_list:
        name = TOOL_ICONS.get(t, "")
        icon = esp_path(f"{icons_dir}/{name}.png") or esp_path(f"icons/{name}.png") if name else ""
        tools.append({"tool": t, "iconFile": icon})
    main = (
        next((e for e in entries if e["name"] == "CachyOS" and "vmlinuz" in (e.get("loader") or "")), None)
        or next((e for e in entries if "vmlinuz" in (e.get("loader") or "")), None)
        or next((e for e in entries if "root=" in (e.get("options") or "")), None)
    )
    default_kernel = re.sub(r"^/?vmlinuz-", "", (main or {}).get("loader", "").strip())
    installed_kernels = []
    try:
        installed_kernels = sorted(
            f[len("vmlinuz-"):] for f in os.listdir("/boot")
            if f.startswith("vmlinuz-") and os.path.exists(f"/boot/initramfs-{f[len('vmlinuz-'):]}.img")
        )
    except OSError:
        installed_kernels = []
    if not installed_kernels:
        candidates = ([default_kernel] if default_kernel else []) + [
            re.sub(r"^Kernel\s+", "", k).strip() for k in (main or {}).get("kernels", [])
        ]
        installed_kernels = list(dict.fromkeys(k for k in candidates if k))
    prev_conf = conf + ".caelestia-prev"
    out = {"exported": True, "setup": setup, "exportedAt": int(os.path.getmtime(conf)),
           "linuxEntry": (main or {}).get("name", ""),
           "defaultKernel": default_kernel,
           "installedKernels": installed_kernels,
           "hasBackup": os.path.exists(prev_conf),
           "backupAt": int(os.path.getmtime(prev_conf)) if os.path.exists(prev_conf) else 0,
           "timeout": int(state.get("timeout", "20") or 20), "defaultSelection": state.get("default_selection", "").strip('"'),
           "flavour": flavour, "banner": esp_path(state.get("banner", "")) if state.get("banner") else "",
           "bannerScale": state.get("banner_scale", "noscale"), "selectionBig": esp_path(state.get("selection_big", "")) if state.get("selection_big") else "",
           "selectionSmall": esp_path(state.get("selection_small", "")) if state.get("selection_small") else "",
           "bigIconSize": int(state.get("big_icon_size", "128")), "smallIconSize": int(state.get("small_icon_size", "48")),
           "hideui": words(state.get("hideui", "")), "showtools": tools, "resolution": state.get("resolution", ""),
           "toolsByDefault": "showtools" not in state,
           "entries": entries, "options": (main or {}).get("options", "")}
    # Everything a draft can show: each flavour's background, selection
    # images and icons; rEFInd's own icons; your own (themes/local)
    base = os.path.join(BOOT_EXPORT, REFIND_REL)
    flavours = {}
    for d in sorted(glob.glob(f"{base}/themes/catppuccin/assets/*/")):
        name = os.path.basename(d.rstrip("/"))
        flavours[name] = {"background": d + "background.png", "selectionBig": d + "selection_big.png",
                          "selectionSmall": d + "selection_small.png", "iconsDir": d + "icons",
                          "icons": sorted(os.path.basename(f) for f in glob.glob(d + "icons/*.png"))}
    out["flavours"] = flavours
    out["stockIcons"] = sorted(os.path.basename(f) for f in glob.glob(f"{base}/icons/os_*.png"))
    out["stockDir"] = f"{base}/icons"
    out["localIcons"] = sorted(os.path.basename(f) for f in glob.glob(f"{base}/themes/local/*.png") if not f.endswith("background.png"))
    out["localDir"] = f"{base}/themes/local"
    out["localBackground"] = f"{base}/themes/local/background.png" if os.path.exists(f"{base}/themes/local/background.png") else ""
    for e in entries:
        icon = (e.get("icon") or "").replace("\\", "/")
        m = re.search(r"/themes/catppuccin/assets/[^/]+/icons/([^/]+)$", icon)
        e["iconSpec"] = f"theme:{m.group(1)}" if m else f"stock:{os.path.basename(icon)}" if "/EFI/refind/icons/" in icon \
            else f"local:{os.path.basename(icon)}" if "/themes/local/" in icon else ""
    print(json.dumps(out))


def pacman_q(name):
    r = subprocess.run(["pacman", "-Q", name], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.split()
    return r[1] if len(r) == 2 else ""


def c_kernels(args):
    running_rel = os.uname().release
    with cf.ThreadPoolExecutor(2) as ex:
        fq = ex.submit(lambda: subprocess.run(["pacman", "-Q"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout)
        fl = ex.submit(lambda: subprocess.run(["pacman", "-Sl"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout)
        q_out = fq.result()
        l_out = fl.result()
    q_vers = {}
    for line in q_out.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2:
            q_vers[parts[0]] = parts[1]
    installed = []
    for d in sorted(glob.glob("/usr/lib/modules/*/pkgbase")):
        base = open(d).read().strip()
        rel = d.split("/")[4]
        nv = (base + "-nvidia-open") if q_vers.get(base + "-nvidia-open") else (base + "-nvidia") if q_vers.get(base + "-nvidia") else ""
        installed.append({"name": base, "version": q_vers.get(base, ""), "release": rel, "running": rel == running_rel,
                          "headers": bool(q_vers.get(base + "-headers")), "nvidia": nv})
    names = {k["name"] for k in installed}
    avail = []
    pkgs = {}
    for line in l_out.split("\n"):
        f = line.split()
        if len(f) >= 3:
            pkgs.setdefault(f[1], (f[0], f[2]))
    for n, (repo, ver) in sorted(pkgs.items()):
        if re.fullmatch(r"linux(-[a-z0-9]+)*", n) and n + "-headers" in pkgs and not re.search(r"-(headers|docs|api|firmware|tools|nvidia.*|zfs|lts-headers)$", n):
            avail.append({"name": n, "version": ver, "repo": repo, "installed": n in names})
    descs = {}
    if avail:
        info = subprocess.run(["pacman", "-Si", *[a["name"] for a in avail]], text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL).stdout
        cur = None
        for line in info.split("\n"):
            if line.startswith("Name"):
                cur = line.split(":", 1)[1].strip()
            elif line.startswith("Description") and cur:
                descs.setdefault(cur, line.split(":", 1)[1].strip())
    for a in avail:
        a["desc"] = descs.get(a["name"], "")
    print(json.dumps({"installed": installed, "available": avail}))


def c_firmware(args):
    out = {"bootCurrent": "", "bootNext": "", "order": [], "entries": []}
    for line in subprocess.run(["efibootmgr"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.split("\n"):
        if line.startswith("BootCurrent:"):
            out["bootCurrent"] = line.split(":", 1)[1].strip()
        elif line.startswith("BootNext:"):
            out["bootNext"] = line.split(":", 1)[1].strip()
        elif line.startswith("BootOrder:"):
            out["order"] = line.split(":", 1)[1].strip().split(",")
        else:
            m = re.match(r"^Boot([0-9A-Fa-f]{4})(\*?)\s+(.+?)\t", line + "\t")
            if m:
                out["entries"].append({"num": m.group(1), "active": m.group(2) == "*", "label": m.group(3).strip()})

    def efivar(name):
        try:
            return open(glob.glob(f"/sys/firmware/efi/efivars/{name}-*")[0], "rb").read()[-1]
        except (OSError, IndexError):
            return None
    out["secureBoot"] = efivar("SecureBoot")
    out["setupMode"] = efivar("SetupMode")
    out["fwupd"] = os.path.exists("/usr/bin/fwupdmgr")
    print(json.dumps(out))


def _strip_html(text):
    plain = re.sub(r"<[^>]+>", " ", html.unescape(text or ""))
    return " ".join(plain.split())


def c_fwupd(args):
    if not os.path.exists("/usr/bin/fwupdmgr"):
        print(json.dumps({"installed": False, "devices": [], "updates": [], "needsReboot": False, "error": ""}))
        return
    refresh = "--refresh" in args
    error = ""
    if refresh:
        ref = subprocess.run(["fwupdmgr", "refresh", "--force"], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if ref.returncode not in (0, 2):
            error = (ref.stderr or ref.stdout or "").strip().splitlines()[-1] if (ref.stderr or ref.stdout or "").strip() else "Failed to refresh firmware metadata"

    devices = []
    needs_reboot = False
    dev_proc = subprocess.run(["fwupdmgr", "get-devices", "--json"], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if dev_proc.returncode == 0 and dev_proc.stdout.strip():
        try:
            for d in json.loads(dev_proc.stdout).get("Devices", []):
                name = (d.get("Name") or "").strip()
                flags = d.get("Flags") or []
                if not name or "updatable" not in flags:
                    continue
                vendor = (d.get("Vendor") or "").strip()
                if name.startswith("-") and vendor:
                    name = f"{vendor}{name}"
                state = d.get("UpdateState")
                dev_reboot = state in (3, "needs-reboot", "needs-shutdown")
                needs_reboot = needs_reboot or dev_reboot
                devices.append({
                    "id": d.get("DeviceId") or "",
                    "name": name,
                    "vendor": vendor,
                    "version": d.get("Version") or "",
                    "summary": d.get("Summary") or "",
                    "needsReboot": dev_reboot,
                    "isInternal": "internal" in flags,
                })
        except (ValueError, KeyError, TypeError) as e:
            error = error or str(e)
    elif dev_proc.stderr.strip() and not error:
        error = dev_proc.stderr.strip().splitlines()[-1]

    updates = []
    upd_proc = subprocess.run(["fwupdmgr", "get-updates", "--json"], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if upd_proc.returncode in (0, 2) and upd_proc.stdout.strip():
        try:
            for d in json.loads(upd_proc.stdout).get("Devices", []):
                rels = d.get("Releases") or []
                if not rels:
                    continue
                rel = rels[0]
                name = (d.get("Name") or "").strip()
                vendor = (d.get("Vendor") or "").strip()
                if name.startswith("-") and vendor:
                    name = f"{vendor}{name}"
                updates.append({
                    "id": d.get("DeviceId") or "",
                    "name": name,
                    "vendor": vendor,
                    "currentVersion": d.get("Version") or "",
                    "newVersion": rel.get("Version") or "",
                    "summary": d.get("Summary") or "",
                    "description": _strip_html(rel.get("Description") or rel.get("Summary") or ""),
                })
        except (ValueError, KeyError, TypeError) as e:
            error = error or str(e)
    elif upd_proc.returncode not in (0, 2) and not error:
        msg = (upd_proc.stderr or upd_proc.stdout or "").strip()
        error = msg.splitlines()[-1] if msg else "Failed to check firmware updates"

    print(json.dumps({
        "installed": True,
        "devices": devices,
        "updates": updates,
        "needsReboot": needs_reboot,
        "error": error,
    }))


def _du_bytes(path):
    if not path or not os.path.exists(path):
        return 0
    try:
        # du prints the total even when some folders can't be read (exit 1):
        # that total is still the size of what is there
        p = subprocess.run(["du", "-sxb", path], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=15)
        parts = p.stdout.split()
        return int(parts[0]) if p.returncode in (0, 1) and parts and parts[0].isdigit() else 0
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 0


def _steam_libraries():
    home = os.path.expanduser("~")
    root = os.path.realpath(os.path.join(home, ".steam/root")) if os.path.exists(os.path.join(home, ".steam/root")) \
        else os.path.join(home, ".local/share/Steam")
    libs = [root]
    vdf = os.path.join(root, "steamapps/libraryfolders.vdf")
    if os.path.isfile(vdf):
        try:
            text = open(vdf, errors="replace").read()
            for p in re.findall(r'"path"\s+"([^"]+)"', text):
                p = p.replace("\\\\", "\\")
                if os.path.realpath(p) not in [os.path.realpath(x) for x in libs]:
                    libs.append(p)
        except OSError:
            pass
    return [l for l in libs if os.path.isdir(os.path.join(l, "steamapps"))]


def c_storage_overview(args):
    apps = 0
    for desc in glob.glob("/var/lib/pacman/local/*/desc"):
        try:
            text = open(desc, errors="ignore").read()
            idx = text.find("%SIZE%\n")
            if idx >= 0:
                end = text.find("\n", idx + 7)
                apps += int(text[idx + 7:end if end >= 0 else None].strip())
        except (OSError, ValueError):
            pass
    apps += _du_bytes("/var/lib/flatpak") + _du_bytes(os.path.expanduser("~/.local/share/flatpak"))

    games = 0
    for lib in _steam_libraries():
        for acf in glob.glob(os.path.join(lib, "steamapps/appmanifest_*.acf")):
            try:
                text = open(acf, errors="replace").read()
                m = re.search(r'"SizeOnDisk"\s+"(\d+)"', text)
                if m:
                    games += int(m.group(1))
            except (OSError, ValueError):
                pass
    games += _du_bytes(os.path.expanduser("~/Games"))

    caches = _du_bytes("/var/cache/pacman/pkg") + _du_bytes(os.path.expanduser("~/.cache"))
    logs = _du_bytes("/var/log/journal") + _du_bytes("/var/lib/systemd/coredump")

    snap_count = 0
    snap_bytes = 0
    for cfg, fallback_dir in (("root", "/.snapshots"), ("home", "/home/.snapshots")):
        got = False
        try:
            raw = subprocess.run(["snapper", "--jsonout", "-c", cfg, "list"], text=True,
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=4).stdout
            if raw.strip():
                rows = [s for s in (json.loads(raw).get(cfg) or []) if s.get("number") not in (0, "0", None)]
                snap_count += len(rows)
                snap_bytes += sum(int(s.get("used-space") or 0) for s in rows)
                got = True
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
        if not got and os.path.isdir(fallback_dir):
            try:
                snap_count += sum(1 for n in os.listdir(fallback_dir) if n.isdigit() and n != "0")
            except OSError:
                pass

    print(json.dumps({
        "apps": apps,
        "games": games,
        "caches": caches,
        "logs": logs,
        "snapshots": snap_bytes,
        "snapshotCount": snap_count,
    }))


def c_locales(args):
    conf = {}
    if os.path.isfile("/etc/locale.conf"):
        try:
            for line in open("/etc/locale.conf", errors="replace"):
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                conf[k.strip()] = v.strip().strip('"').strip("'")
        except OSError:
            pass
    if not conf.get("LANG"):
        for line in sh("localectl", "status").splitlines():
            m = re.search(r"\b(LANG|LC_TIME|LC_NUMERIC)=([^\s]+)", line)
            if m:
                conf.setdefault(m.group(1), m.group(2))
    lang = conf.get("LANG") or os.environ.get("LANG") or "en_US.UTF-8"
    regional = conf.get("LC_TIME") or conf.get("LC_NUMERIC") or lang

    enabled_set = set()
    for line in sh("locale", "-a").splitlines():
        loc = line.strip()
        if loc.lower().endswith(".utf8"):
            loc = loc[:-5] + ".UTF-8"
        elif loc.lower().endswith(".utf-8"):
            loc = loc[:-6] + ".UTF-8"
        if re.fullmatch(r"[a-z]{2,3}_[A-Z]{2}\.UTF-8", loc):
            enabled_set.add(loc)

    available_set = set(enabled_set)
    if os.path.isfile("/etc/locale.gen"):
        try:
            for line in open("/etc/locale.gen", errors="replace"):
                m = re.match(r"^(#?)\s*([a-z]{2,3}_[A-Z]{2}\.UTF-8)\b", line)
                if m:
                    available_set.add(m.group(2))
                    if not m.group(1):
                        enabled_set.add(m.group(2))
        except OSError:
            pass

    print(json.dumps({
        "lang": lang,
        "regional": regional,
        "enabled": sorted(enabled_set),
        "available": sorted(available_set),
    }))


def rollback_blocker():
    """Why snapper's rollback can't work here ("" when it can): it changes the
    btrfs default subvolume, which is ignored when the boot entry
    (rootflags=subvol=...) or fstab names the root's subvolume itself."""
    try:
        cmdline = open("/proc/cmdline").read()
    except OSError:
        cmdline = ""
    m = re.search(r"\brootflags=(\S+)", cmdline)
    if m and re.search(r"(^|,)subvol(id)?=", m.group(1)):
        return f"the boot entry names the system's subvolume ({m.group(1)})"
    try:
        for line in open("/etc/fstab"):
            f = line.split()
            if len(f) >= 4 and not f[0].startswith("#") and f[1] == "/" and re.search(r"(^|,)subvol(id)?=", f[3]):
                return f"/etc/fstab names the system's subvolume ({f[3].split(',')[0]})"
    except OSError:
        pass
    return ""


def booted_from_snapshot():
    fsroot = sh("findmnt", "-n", "-o", "FSROOT", "/").strip()
    return fsroot, "/.snapshots/" in fsroot or "/.refind-btrfs/" in fsroot


def c_rollback_status(args):
    """rollback-status: whether this boot is a snapshot and whether rollback can work."""
    fsroot, booted = booted_from_snapshot()
    print(json.dumps({"fsroot": fsroot, "bootedSnapshot": booted, "rollbackBlocker": rollback_blocker()}))


def c_security_status(args):
    fw = "none"
    if os.path.exists("/usr/bin/ufw"):
        active = sh("systemctl", "is-active", "ufw").strip() == "active"
        conf_on = False
        try:
            conf_on = any(l.strip() == "ENABLED=yes" for l in open("/etc/ufw/ufw.conf", errors="replace"))
        except OSError:
            pass
        fw = "active" if active and conf_on else "inactive"

    def efivar(name):
        try:
            return open(glob.glob(f"/sys/firmware/efi/efivars/{name}-*")[0], "rb").read()[-1]
        except (OSError, IndexError):
            return None

    sb_val = efivar("SecureBoot")
    if not os.path.isdir("/sys/firmware/efi"):
        sb_state = "bios"
    elif sb_val == 1:
        sb_state = "enabled"
    elif sb_val == 0:
        sb_state = "disabled"
    else:
        sb_state = "unknown"

    sbctl_installed = os.path.exists("/usr/bin/sbctl")
    sbctl_enrolled = False
    setup_mode = efivar("SetupMode") == 1
    if sbctl_installed:
        try:
            st = json.loads(sh("sbctl", "status", "--json") or "{}")
            sbctl_enrolled = bool(st.get("installed"))
            if "setup_mode" in st:
                setup_mode = bool(st.get("setup_mode"))
        except ValueError:
            pass

    tpm_ver = ""
    for p in glob.glob("/sys/class/tpm/*/tpm_version_major"):
        try:
            raw = open(p).read().strip()
            if raw == "2":
                tpm_ver = "2.0"
                break
            if raw == "1":
                tpm_ver = "1.2"
        except OSError:
            pass

    encrypted_mounts = []
    try:
        devs = json.loads(sh("lsblk", "-J", "-o", "NAME,TYPE,FSTYPE,MOUNTPOINTS") or "{}")

        def walk(node):
            tp = node.get("type") or ""
            fs = node.get("fstype") or ""
            mps = [m for m in (node.get("mountpoints") or []) if m]
            if tp == "crypt" or fs == "crypto_LUKS":
                encrypted_mounts.extend(mps or [f"/dev/{node.get('name', '')}"])
            for ch in node.get("children") or []:
                walk(ch)

        for b in devs.get("blockdevices") or []:
            walk(b)
    except ValueError:
        pass

    fsroot, booted_snapshot = booted_from_snapshot()

    flatpak_installed = os.path.exists("/usr/bin/flatpak")
    perms = []
    if flatpak_installed:
        raw_p = subprocess.run(["flatpak", "permissions", "-j"], text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.strip()
        if raw_p:
            try:
                parsed = json.loads(raw_p)
                if isinstance(parsed, list):
                    for row in parsed:
                        if not isinstance(row, dict):
                            continue
                        p_val = row.get("permissions")
                        p_text = ", ".join(str(x) for x in p_val) if isinstance(p_val, list) else str(p_val or "")
                        perms.append({
                            "table": str(row.get("table") or ""),
                            # flatpak's JSON calls this column "object" (older output: "id")
                            "id": str(row.get("object") or row.get("id") or ""),
                            "app": str(row.get("app") or row.get("app-id") or ""),
                            "permissions": p_text,
                        })
            except ValueError:
                pass

    print(json.dumps({
        "firewall": fw,
        "secureBoot": sb_state,
        "sbctlInstalled": sbctl_installed,
        "sbctlEnrolled": sbctl_enrolled,
        "setupMode": setup_mode,
        "tpmVersion": tpm_ver,
        "encrypted": len(encrypted_mounts) > 0,
        "encryptedTargets": sorted(set(encrypted_mounts)),
        "fsroot": fsroot,
        "bootedSnapshot": booted_snapshot,
        "rollbackBlocker": rollback_blocker(),
        "flatpakInstalled": flatpak_installed,
        "permissions": perms,
    }))


