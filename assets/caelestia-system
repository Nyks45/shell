#!/usr/bin/python3 -I
"""Caelestia settings: services, scheduled tasks, logs, crash reports and
users, read as JSON for the settings app (runs as the user).

    caelestia-system units [--user]          services: state, enabled, description
    caelestia-system unit NAME [--user]      one service's details
    caelestia-system timers [--user]         scheduled tasks: next/last run
    caelestia-system logs [--boot N] [--priority P] [--unit U] [--grep TEXT] [--lines N] [--user]
    caelestia-system boots                   the recorded boots
    caelestia-system crashes                 crash reports (coredumpctl)
    caelestia-system crash PID               one crash report as text (for bug reports)
    caelestia-system users                   people's accounts and the groups they can join
    caelestia-system user-add NAME FULLNAME admin|standard   (password on stdin)
    caelestia-system user-delete NAME [--remove-files]
    caelestia-system user-type NAME admin|standard
    caelestia-system user-password NAME      (password on stdin)
    caelestia-system boot                    the boot menu (rEFInd) as it shows, for the preview
    caelestia-system kernels                 installed kernels and the ones to install
    caelestia-system firmware                UEFI boot entries, Secure Boot, firmware updates

Changes go through AccountsService, which asks polkit (the shell's prompt);
starting/stopping services is plain systemctl (polkit too); group
memberships go through the root helper (caelestia-admin group-member).
"""

import glob
import grp
import json
import os
import pwd
import re
import subprocess
import sys
import time

from gi.repository import Gio, GLib


def sh(*cmd):
    p = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return p.stdout


def scope(args):
    return ["--user"] if "--user" in args else []


# --- services ----------------------------------------------------------------

def c_units(args):
    s = scope(args)
    units = {u["unit"]: u for u in json.loads(sh("systemctl", *s, "list-units", "--type=service", "--all", "-o", "json") or "[]")}
    files = {f["unit_file"]: f["state"] for f in json.loads(sh("systemctl", *s, "list-unit-files", "--type=service", "-o", "json") or "[]")}
    out = []
    for name in sorted(set(units) | set(files)):
        if name.endswith("@.service") and name not in units:
            continue  # templates: their instances show instead
        u = units.get(name, {})
        out.append({"name": name, "description": u.get("description", ""), "load": u.get("load", ""),
                    "active": u.get("active", "inactive"), "sub": u.get("sub", "dead"),
                    "enabled": files.get(name, files.get(re.sub(r"@[^.]+\.", "@.", name), ""))})
    print(json.dumps(out))


PROPS = ["Id", "Description", "LoadState", "ActiveState", "SubState", "UnitFileState", "UnitFilePreset",
         "FragmentPath", "MainPID", "MemoryCurrent", "CPUUsageNSec", "ActiveEnterTimestamp",
         "InactiveEnterTimestamp", "ExecMainStartTimestamp", "Restart", "Type", "User", "Documentation",
         "TriggeredBy", "Wants", "After", "Result", "NRestarts", "CanStart", "CanStop", "CanReload"]


def c_unit(args):
    name = args[0]
    s = scope(args[1:])
    out = {}
    for line in sh("systemctl", *s, "show", name, "-p", ",".join(PROPS)).splitlines():
        k, _, v = line.partition("=")
        out[k] = v
    # time and message only (the date, host and process are the same on every line)
    lines = []
    for line in sh("journalctl", *s, "-u" if not s else "--user-unit", name, "-n", "40", "-o", "json", "--no-pager").splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE", "")
        if isinstance(msg, list):
            msg = bytes(x for x in msg if isinstance(x, int)).decode(errors="replace")
        t = int(e.get("__REALTIME_TIMESTAMP", 0)) // 1000000
        lines.append(time.strftime("%d %b %H:%M:%S", time.localtime(t)) + "  " + msg)
    out["log"] = lines[-40:]
    print(json.dumps(out))


def c_timers(args):
    s = scope(args)
    timers = json.loads(sh("systemctl", *s, "list-timers", "--all", "-o", "json") or "[]")
    files = {f["unit_file"]: f["state"] for f in json.loads(sh("systemctl", *s, "list-unit-files", "--type=timer", "-o", "json") or "[]")}
    for t in timers:
        t["enabled"] = files.get(t["unit"], "")
        desc = sh("systemctl", *s, "show", t["unit"], "-p", "Description", "--value").strip()
        t["description"] = desc
    print(json.dumps(timers))


# --- logs ---------------------------------------------------------------------

PRIORITY = {"0": "emerg", "1": "alert", "2": "crit", "3": "err", "4": "warning", "5": "notice", "6": "info", "7": "debug"}


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def c_logs(args):
    cmd = ["journalctl", "-o", "json", "--no-pager", "-n", opt(args, "--lines", "400")]
    if "--user" in args:
        cmd.append("--user")
    boot = opt(args, "--boot", "0")
    cmd += ["-b", boot]
    pri = opt(args, "--priority")
    if pri:
        if not re.fullmatch(r"[0-7]", pri):
            sys.exit("bad priority")
        cmd += ["-p", pri]
    unit = opt(args, "--unit")
    if unit:
        cmd += ["-u", unit]
    text = opt(args, "--grep")
    if text:
        cmd += ["--case-sensitive=false", "-g", re.escape(text)]
    out = []
    for line in sh(*cmd).splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE", "")
        if isinstance(msg, list):  # binary messages come as byte arrays
            msg = bytes(x for x in msg if isinstance(x, int)).decode(errors="replace")
        out.append({"time": int(e.get("__REALTIME_TIMESTAMP", 0)) // 1000, "priority": int(e.get("PRIORITY", 6)),
                    "unit": e.get("_SYSTEMD_UNIT") or e.get("_SYSTEMD_USER_UNIT") or "",
                    "ident": e.get("SYSLOG_IDENTIFIER") or e.get("_COMM") or "",
                    "message": msg[:2000]})
    out.reverse()  # newest first
    print(json.dumps(out))


def c_boots(args):
    print(sh("journalctl", "--list-boots", "-o", "json") or "[]")


def c_crashes(args):
    try:
        items = json.loads(sh("coredumpctl", "list", "--json=short", "--no-pager") or "[]")
    except ValueError:
        items = []
    items.sort(key=lambda c: -c.get("time", 0))
    print(json.dumps(items[:200]))


def c_crash(args):
    if not args or not args[0].isdigit():
        sys.exit("crash PID")
    print(sh("coredumpctl", "info", "--no-pager", args[0]))


# --- users ---------------------------------------------------------------------

def c_users(args):
    admins = set(grp.getgrnam("wheel").gr_mem) if "wheel" in [g.gr_name for g in grp.getgrall()] else set()
    users = []
    for p in pwd.getpwall():
        if 1000 <= p.pw_uid < 60000 and p.pw_shell not in ("/usr/bin/nologin", "/bin/false", "/sbin/nologin"):
            groups = sorted(g.gr_name for g in grp.getgrall() if p.pw_name in g.gr_mem)
            users.append({"name": p.pw_name, "uid": p.pw_uid, "fullName": p.pw_gecos.split(",")[0],
                          "home": p.pw_dir, "admin": p.pw_name in admins, "groups": groups,
                          "me": p.pw_uid == os.getuid()})
    # Groups a person may usefully join (hardware and service access), with what they give
    useful = {"wheel": "Administrator (sudo, the password prompt)", "audio": "Sound devices directly",
              "video": "Graphics and camera devices", "input": "Input devices (keyboards, mice, controllers)",
              "storage": "Removable drives", "lp": "Printers", "scanner": "Scanners", "network": "Network settings",
              "i2c": "Monitor brightness over the cable (DDC/CI)", "docker": "Docker containers",
              "libvirt": "Virtual machines", "kvm": "Virtual machine acceleration", "uucp": "Serial ports",
              "rfkill": "Turning radios on and off", "games": "Shared game data", "adm": "Reading all system logs",
              "systemd-journal": "Reading all system logs", "realtime": "Real-time audio priority",
              "gamemode": "GameMode", "plugdev": "Pluggable devices"}
    existing = {g.gr_name for g in grp.getgrall()}
    print(json.dumps({"users": users, "groups": [{"name": n, "about": a} for n, a in useful.items() if n in existing]}))


def accounts():
    return Gio.bus_get_sync(Gio.BusType.SYSTEM)


def acc_call(path, iface, method, sig, args, reply=None):
    v = accounts().call_sync("org.freedesktop.Accounts", path, iface, method, GLib.Variant(sig, args),
                             GLib.VariantType(reply) if reply else None,
                             Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 120000, None)
    return v.unpack() if v is not None else None


def user_path(name):
    return acc_call("/org/freedesktop/Accounts", "org.freedesktop.Accounts", "FindUserByName", "(s)", (name,), "(o)")[0]


NAME = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")


def hashed(password):
    if not password or "\n" in password:
        sys.exit("no password given")
    return subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=password + "\n", text=True,
                          stdout=subprocess.PIPE, check=True).stdout.strip()


def c_user_add(args):
    name, full, kind = args[0], args[1], args[2]
    if not NAME.match(name) or kind not in ("admin", "standard"):
        sys.exit("bad name or type")
    pw = sys.stdin.readline().rstrip("\n")
    path = acc_call("/org/freedesktop/Accounts", "org.freedesktop.Accounts", "CreateUser", "(ssi)",
                    (name, full, 1 if kind == "admin" else 0), "(o)")[0]
    if pw:
        acc_call(path, "org.freedesktop.Accounts.User", "SetPassword", "(ss)", (hashed(pw), ""))
    print(path)


def c_user_delete(args):
    name = args[0]
    if pwd.getpwnam(name).pw_uid == os.getuid():
        sys.exit("not your own account")
    acc_call("/org/freedesktop/Accounts", "org.freedesktop.Accounts", "DeleteUser", "(xb)",
             (pwd.getpwnam(name).pw_uid, "--remove-files" in args))


def c_user_type(args):
    name, kind = args[0], args[1]
    if kind not in ("admin", "standard"):
        sys.exit("admin or standard")
    if pwd.getpwnam(name).pw_uid == os.getuid() and kind == "standard":
        sys.exit("you can't take away your own administrator rights here")
    acc_call(user_path(name), "org.freedesktop.Accounts.User", "SetAccountType", "(i)", (1 if kind == "admin" else 0,))


def c_user_password(args):
    acc_call(user_path(args[0]), "org.freedesktop.Accounts.User", "SetPassword", "(ss)",
             (hashed(sys.stdin.readline().rstrip("\n")), ""))


# --- boot ----------------------------------------------------------------------

BOOT_EXPORT = "/var/lib/caelestia/boot"
REFIND_REL = "EFI/refind"
TOOL_ICONS = {"shutdown": "func_shutdown", "reboot": "func_reset", "firmware": "func_firmware", "about": "func_about",
              "exit": "func_exit", "hidden_tags": "func_hidden", "memtest": "tool_memtest", "shell": "tool_shell",
              "gdisk": "tool_part", "netboot": "tool_netboot", "mok_tool": "tool_mok_tool", "bootorder": "func_bootorder",
              "windows_recovery": "tool_windows_rescue", "apple_recovery": "tool_apple_rescue", "fwupdate": "tool_fwupdate",
              "csr_rotate": "func_csr_rotate", "install": "func_install"}


def esp_path(p):
    """A path in refind.conf (from the ESP root, or relative to rEFInd's folder) in the readable copy."""
    p = p.strip().strip('"').replace("\\", "/")
    full = os.path.join(BOOT_EXPORT, p.lstrip("/")) if p.startswith("/") or p.upper().startswith("EFI/") else \
        os.path.join(BOOT_EXPORT, REFIND_REL, p)
    return full if os.path.exists(full) else ""


def parse_refind(path, state, entries, depth=0):
    """Directives in file order (an include in place), menu entries."""
    if depth > 4 or not os.path.exists(path):
        return
    lines = open(path, errors="replace").read().split("\n")
    i = 0
    while i < len(lines):
        bare = lines[i].strip()
        i += 1
        if not bare or bare.startswith("#"):
            continue
        m = re.match(r'^menuentry\s+"?([^"{]+?)"?\s*\{$', bare)
        if m:
            e = {"name": m.group(1).strip(), "submenus": [], "disabled": False, "kernels": []}
            lvl, in_kern = 1, False
            while i < len(lines) and lvl > 0:
                l = lines[i].strip()
                i += 1
                if l.startswith("# hidden in Settings"):
                    e["hiddenBySettings"] = True
                if l.startswith("# BEGIN caelestia-kernels"):
                    in_kern = True
                elif l.startswith("# END caelestia-kernels"):
                    in_kern = False
                if not l or l.startswith("#"):
                    continue
                if l.endswith("{"):
                    lvl += 1
                    sm = re.match(r'^submenuentry\s+"([^"]+)"', l)
                    if sm:
                        (e["kernels"] if in_kern else e["submenus"]).append(sm.group(1))
                    continue
                if l == "}":
                    lvl -= 1
                    continue
                if lvl == 1:
                    k, _, v = l.partition(" ")
                    v = v.strip()
                    if k == "disabled":
                        e["disabled"] = True
                    elif k in ("icon", "loader", "volume", "initrd"):
                        e[k] = v
                    elif k == "options":
                        e["options"] = v.strip('"')
            if not e["disabled"] or e.get("hiddenBySettings"):
                e["iconFile"] = esp_path(e["icon"]) if e.get("icon") else ""
                e["hidden"] = e["disabled"]
                entries.append(e)
            continue
        k, _, v = bare.partition(" ")
        v = v.strip()
        if k == "include":
            parse_refind(os.path.join(BOOT_EXPORT, REFIND_REL, v), state, entries, depth + 1)
        elif k == "showtools" and depth > 0:
            # rEFInd 0.14 adds an included file's tools to the list instead of
            # replacing it (seen: the theme's "shutdown" shows twice)
            state["_includedTools"] = state.get("_includedTools", []) + [w for w in re.split(r"[\s,]+", v) if w]
        else:
            state[k] = v
            state.setdefault("_from", {})[k] = os.path.relpath(path, BOOT_EXPORT)


def c_boot(args):
    conf = os.path.join(BOOT_EXPORT, REFIND_REL, "refind.conf")
    # set up: the watcher keeping this copy current and the kernels hook (boot-setup)
    setup = os.path.exists("/etc/systemd/system/caelestia-boot-export.path") and \
        os.path.exists("/etc/pacman.d/hooks/caelestia-refind-kernels.hook")
    if not os.path.exists(conf):
        print(json.dumps({"exported": False, "setup": setup}))
        return
    state, entries = {}, []
    parse_refind(conf, state, entries)
    words = lambda v: [w for w in re.split(r"[\s,]+", v or "") if w]
    flavour = next((m.group(1) for l in open(conf) if (m := re.match(r"^\s*include\s+themes/catppuccin/(\w+)\.conf", l))), "")
    icons_dir = state.get("icons_dir", "icons")
    # The tools shown: the main file's showtools, or rEFInd's defaults (those
    # it finds: no shell, memtest, gdisk or fwupd tool on this ESP; Windows
    # recovery when Windows is there) followed by any from included files
    if "showtools" in state:
        tool_list = words(state["showtools"])
    else:
        has_windows = any("Microsoft" in (e.get("loader") or "") for e in entries)
        tool_list = (["windows_recovery"] if has_windows else []) + ["about", "hidden_tags", "shutdown", "reboot", "firmware"]
    tool_list += state.get("_includedTools", [])
    tools = []
    for t in tool_list:
        name = TOOL_ICONS.get(t, "")
        icon = esp_path(f"{icons_dir}/{name}.png") or esp_path(f"icons/{name}.png") if name else ""
        tools.append({"tool": t, "iconFile": icon})
    main = next((e for e in entries if e["name"] == "CachyOS"), None)
    out = {"exported": True, "setup": setup, "exportedAt": int(os.path.getmtime(conf)),
           "timeout": int(state.get("timeout", "20") or 20), "defaultSelection": state.get("default_selection", "").strip('"'),
           "flavour": flavour, "banner": esp_path(state.get("banner", "")) if state.get("banner") else "",
           "bannerScale": state.get("banner_scale", "noscale"), "selectionBig": esp_path(state.get("selection_big", "")) if state.get("selection_big") else "",
           "selectionSmall": esp_path(state.get("selection_small", "")) if state.get("selection_small") else "",
           "bigIconSize": int(state.get("big_icon_size", "128")), "smallIconSize": int(state.get("small_icon_size", "48")),
           "hideui": words(state.get("hideui", "")), "showtools": tools, "resolution": state.get("resolution", ""),
           "toolsByDefault": "showtools" not in state,
           "entries": entries, "options": (main or {}).get("options", "")}
    # Everything a draft can show: each flavour's background, selection
    # images and icons; rEFInd's own icons; your own (themes/local)
    base = os.path.join(BOOT_EXPORT, REFIND_REL)
    flavours = {}
    for d in sorted(glob.glob(f"{base}/themes/catppuccin/assets/*/")):
        name = os.path.basename(d.rstrip("/"))
        flavours[name] = {"background": d + "background.png", "selectionBig": d + "selection_big.png",
                          "selectionSmall": d + "selection_small.png", "iconsDir": d + "icons",
                          "icons": sorted(os.path.basename(f) for f in glob.glob(d + "icons/*.png"))}
    out["flavours"] = flavours
    out["stockIcons"] = sorted(os.path.basename(f) for f in glob.glob(f"{base}/icons/os_*.png"))
    out["stockDir"] = f"{base}/icons"
    out["localIcons"] = sorted(os.path.basename(f) for f in glob.glob(f"{base}/themes/local/*.png") if not f.endswith("background.png"))
    out["localDir"] = f"{base}/themes/local"
    out["localBackground"] = f"{base}/themes/local/background.png" if os.path.exists(f"{base}/themes/local/background.png") else ""
    for e in entries:
        icon = (e.get("icon") or "").replace("\\", "/")
        m = re.search(r"/themes/catppuccin/assets/[^/]+/icons/([^/]+)$", icon)
        e["iconSpec"] = f"theme:{m.group(1)}" if m else f"stock:{os.path.basename(icon)}" if "/EFI/refind/icons/" in icon \
            else f"local:{os.path.basename(icon)}" if "/themes/local/" in icon else ""
    print(json.dumps(out))


def pacman_q(name):
    r = subprocess.run(["pacman", "-Q", name], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.split()
    return r[1] if len(r) == 2 else ""


def c_kernels(args):
    running_rel = os.uname().release
    installed = []
    for d in sorted(glob.glob("/usr/lib/modules/*/pkgbase")):
        base = open(d).read().strip()
        rel = d.split("/")[4]
        installed.append({"name": base, "version": pacman_q(base), "release": rel, "running": rel == running_rel,
                          "headers": bool(pacman_q(base + "-headers")),
                          "nvidia": pacman_q(base + "-nvidia-open") and base + "-nvidia-open" or pacman_q(base + "-nvidia") and base + "-nvidia" or ""})
    names = {k["name"] for k in installed}
    avail = []
    listing = subprocess.run(["pacman", "-Sl"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.split("\n")
    pkgs = {}
    for line in listing:
        f = line.split()
        if len(f) >= 3:
            pkgs.setdefault(f[1], (f[0], f[2]))
    for n, (repo, ver) in sorted(pkgs.items()):
        if re.fullmatch(r"linux(-[a-z0-9]+)*", n) and n + "-headers" in pkgs and not re.search(r"-(headers|docs|api|firmware|tools|nvidia.*|zfs|lts-headers)$", n):
            avail.append({"name": n, "version": ver, "repo": repo, "installed": n in names})
    descs = {}
    if avail:
        info = subprocess.run(["pacman", "-Si", *[a["name"] for a in avail]], text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL).stdout
        cur = None
        for line in info.split("\n"):
            if line.startswith("Name"):
                cur = line.split(":", 1)[1].strip()
            elif line.startswith("Description") and cur:
                descs.setdefault(cur, line.split(":", 1)[1].strip())
    for a in avail:
        a["desc"] = descs.get(a["name"], "")
    print(json.dumps({"installed": installed, "available": avail}))


def c_firmware(args):
    out = {"bootCurrent": "", "bootNext": "", "order": [], "entries": []}
    for line in subprocess.run(["efibootmgr"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.split("\n"):
        if line.startswith("BootCurrent:"):
            out["bootCurrent"] = line.split(":", 1)[1].strip()
        elif line.startswith("BootNext:"):
            out["bootNext"] = line.split(":", 1)[1].strip()
        elif line.startswith("BootOrder:"):
            out["order"] = line.split(":", 1)[1].strip().split(",")
        else:
            m = re.match(r"^Boot([0-9A-Fa-f]{4})(\*?)\s+(.+?)\t", line + "\t")
            if m:
                out["entries"].append({"num": m.group(1), "active": m.group(2) == "*", "label": m.group(3).strip()})

    def efivar(name):
        try:
            return open(glob.glob(f"/sys/firmware/efi/efivars/{name}-*")[0], "rb").read()[-1]
        except (OSError, IndexError):
            return None
    out["secureBoot"] = efivar("SecureBoot")
    out["setupMode"] = efivar("SetupMode")
    out["fwupd"] = os.path.exists("/usr/bin/fwupdmgr")
    print(json.dumps(out))


COMMANDS = {"units": c_units, "unit": c_unit, "timers": c_timers, "logs": c_logs, "boots": c_boots,
            "crashes": c_crashes, "crash": c_crash, "users": c_users, "user-add": c_user_add,
            "user-delete": c_user_delete, "user-type": c_user_type, "user-password": c_user_password,
            "boot": c_boot, "kernels": c_kernels, "firmware": c_firmware}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        return COMMANDS[argv[0]](argv[1:]) or 0
    except (IndexError, KeyError):
        print(f"usage: see caelestia-system --help ({argv[0]})", file=sys.stderr)
        return 2
    except GLib.Error as e:
        msg = Gio.DBusError.get_remote_error(e) or ""
        print(e.message.split(":", 2)[-1].strip(), file=sys.stderr)
        return 126 if "NotAuthorized" in msg or "PermissionDenied" in msg else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
