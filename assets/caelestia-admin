#!/usr/bin/python3 -I
"""Caelestia settings: the system changes the settings app makes as root.

Runs through pkexec (polkit action org.caelestia.shell.admin: the shell's own
password prompt, remembered for a few minutes). Only the named actions below,
each argument checked: never an arbitrary command, so a remembered password
can't be used to run anything else.

    caelestia-admin [--dry-run] ACTION [ARGS...]

--dry-run prints the commands instead of running them (tests). Progress goes
to stdout, errors to stderr; exit 2 = refused (bad action or argument).
"""

import json
import os
import pwd
import re
import subprocess
import sys

DRY = False


class Refused(Exception):
    pass


def run(*cmd, input=None, check=True):
    print("$ " + " ".join(cmd), flush=True)
    if DRY:
        return ""
    proc = subprocess.run(cmd, input=input, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if proc.stdout:
        print(proc.stdout, end="" if proc.stdout.endswith("\n") else "\n", flush=True)
    if check and proc.returncode != 0:
        raise SystemExit(proc.returncode)
    return proc.stdout


def write_file(path, text):
    print(f"$ write {path}", flush=True)
    if DRY:
        print(text, end="")
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".caelestia-new"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def caller():
    """The user who asked (pkexec sets PKEXEC_UID)."""
    uid = os.environ.get("PKEXEC_UID")
    if uid is None or not uid.isdigit():
        raise Refused("not started through pkexec")
    return pwd.getpwuid(int(uid)).pw_name


def need(args, count, usage):
    if len(args) != count:
        raise Refused(f"usage: {usage}")


PKG = re.compile(r"^[a-z0-9@_+][a-z0-9@._+-]*$")
CONFIG = re.compile(r"^[A-Za-z0-9_-]{1,64}$")


def check_pkgs(names):
    if not names:
        raise Refused("no packages")
    for n in names:
        if not PKG.match(n):
            raise Refused(f"not a package name: {n!r}")
    return names


# --- actions ---------------------------------------------------------------

POWER_KEY = {"ignore", "poweroff", "reboot", "suspend", "hibernate", "hybrid-sleep", "suspend-then-hibernate", "lock"}


def act_power_key(args):
    """power-key ACTION: what logind does with the power button."""
    need(args, 1, "power-key " + "|".join(sorted(POWER_KEY)))
    if args[0] not in POWER_KEY:
        raise Refused(f"unknown power key action {args[0]!r}")
    write_file("/etc/systemd/logind.conf.d/10-power-key.conf", f"[Login]\nHandlePowerKey={args[0]}\n")
    run("systemctl", "kill", "-s", "HUP", "systemd-logind")


def act_install(args):
    """install PKG...: from the repositories (never a local file)."""
    run("pacman", "-S", "--needed", "--noconfirm", "--", *check_pkgs(args))


def act_upgrade(args):
    """upgrade [--ignore PKG...]: every repository package (pacman -Syu), but
    the ones named after --ignore (pacman's own way to keep some back)."""
    ignore = []
    if args:
        if args[0] != "--ignore":
            raise Refused("usage: upgrade [--ignore PKG...]")
        ignore = check_pkgs(args[1:])
    run("pacman", "-Syu", "--noconfirm", *(["--ignore", ",".join(ignore)] if ignore else []))


# Never removed from the settings (they'd leave the system unbootable or
# without the shell): refused when a removal would take any of them
PROTECTED = re.compile(r"^(base|base-devel|linux(-[a-z0-9-]+)?|linux-firmware.*|systemd|systemd-libs|glibc|pacman|"
                       r"sudo|polkit|filesystem|bash|coreutils|util-linux|grub|refind|efibootmgr|mkinitcpio|dracut|"
                       r"networkmanager|hyprland|quickshell(-git)?|caelestia-shell.*|caelestia-cli|mesa|nvidia.*|"
                       r"lib32-nvidia.*|xdg-desktop-portal.*|pipewire|wireplumber|dbus|dbus-broker.*|openssl|"
                       r"cachyos-keyring|archlinux-keyring|btrfs-progs|snapper)$")


def act_remove(args):
    """remove [--keep-deps] PKG...: uninstall packages (with the dependencies
    nothing else needs, unless --keep-deps); refuses a removal that would take
    an essential package along."""
    keep = args[:1] == ["--keep-deps"]
    names = check_pkgs(args[1:] if keep else args)
    flags = "-R" if keep else "-Rs"
    # What the removal would take, before anything happens
    plan = subprocess.run(["pacman", flags + "p", "--print-format", "%n", "--", *names], text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if plan.returncode != 0:
        print(plan.stdout, flush=True)
        raise SystemExit(plan.returncode)
    taken = plan.stdout.split()
    bad = [n for n in taken if PROTECTED.match(n)]
    if bad:
        raise Refused("this would remove essential packages: " + ", ".join(bad))
    print("Removing: " + " ".join(taken), flush=True)
    run("pacman", flags, "--noconfirm", "--", *names)


def cache_dirs():
    dirs = []
    for line in open("/etc/pacman.conf"):
        line = line.split("#", 1)[0].strip()
        if line.startswith("CacheDir") and "=" in line:
            dirs += line.split("=", 1)[1].split()
    return [os.path.realpath(d) for d in (dirs or ["/var/cache/pacman/pkg"])]


PKGFILE = re.compile(r"^[a-z0-9@_+][a-z0-9@._+-]*-[^-/]+-[^-/]+-(x86_64(_v[234])?|any)\.pkg\.tar\.(zst|xz)$")


def act_downgrade(args):
    """downgrade FILE: install an older version from the package cache (only a
    package file that is in the cache)."""
    need(args, 1, "downgrade FILE")
    path = os.path.realpath(args[0])
    if os.path.dirname(path) not in cache_dirs() or not PKGFILE.match(os.path.basename(path)) or not os.path.isfile(path):
        raise Refused("not a package file in the package cache")
    run("pacman", "-U", "--noconfirm", "--", path)


def set_ignore(pkg, hold, path="/etc/pacman.conf"):
    """IgnorePkg in pacman.conf's [options]: add or drop one package (the
    first IgnorePkg line, commented or not, becomes the one line)."""
    lines = open(path).read().split("\n")
    try:
        start = next(i for i, l in enumerate(lines) if l.strip() == "[options]")
    except StopIteration:
        raise Refused("no [options] section in pacman.conf")
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("[")), len(lines))
    names, first = [], None
    for i in range(start + 1, end):
        m = re.match(r"^\s*(#?)\s*IgnorePkg\s*=(.*)$", lines[i])
        if m:
            first = i if first is None else first
            if not m.group(1):
                names += m.group(2).split()
            lines[i] = None
    names = [n for n in dict.fromkeys(names) if n != pkg] + ([pkg] if hold else [])
    new = ("IgnorePkg   = " + " ".join(names)) if names else "#IgnorePkg   ="
    if first is not None:
        lines[first] = new
    else:
        lines.insert(end, new)
    if not os.path.exists(path + ".caelestia-bak"):
        run("cp", "-a", path, path + ".caelestia-bak")
    write_file(path, "\n".join(l for l in lines if l is not None))


def act_hold(args):
    """hold PKG: keep it at its version (left out of updates)."""
    need(args, 1, "hold PKG")
    set_ignore(check_pkgs(args)[0], True)


def act_unhold(args):
    """unhold PKG: update it again."""
    need(args, 1, "unhold PKG")
    set_ignore(check_pkgs(args)[0], False)


def act_pacnew(args):
    """pacnew PATH keep-new|keep-old: a configuration file an update brought
    (.pacnew) or kept (.pacsave): use it (the current one is saved as
    .caelestia-old) or keep the current one (it is deleted)."""
    need(args, 2, "pacnew PATH keep-new|keep-old")
    path = args[0]
    if (os.path.realpath(path) != path or not path.startswith("/etc/") or not path.endswith((".pacnew", ".pacsave"))
            or not os.path.isfile(path)):
        raise Refused("not a .pacnew/.pacsave file under /etc")
    orig = path.rsplit(".", 1)[0]
    if args[1] == "keep-new":
        if os.path.exists(orig):
            run("cp", "-a", orig, orig + ".caelestia-old")
        run("mv", "-f", path, orig)
    elif args[1] == "keep-old":
        run("rm", "-f", path)
    else:
        raise Refused("keep-new or keep-old")


def act_pacnew_undo(args):
    """pacnew-undo PATH.caelestia-old: put back your file that "use the new
    one" replaced (the new one is kept as .pacnew again)."""
    if not 1 <= len(args) <= 2:
        raise Refused("usage: pacnew-undo PATH.caelestia-old [--forget]")
    path = args[0]
    if os.path.realpath(path) != path or not path.startswith("/etc/") or not path.endswith(".caelestia-old") \
            or not os.path.isfile(path):
        raise Refused("not a saved file under /etc")
    orig = path[:-len(".caelestia-old")]
    if len(args) > 1 and args[1] == "--forget":  # keep the new one: your saved copy goes
        run("rm", "-f", path)
        return
    if os.path.exists(orig):
        run("cp", "-a", orig, orig + ".pacnew")
    run("mv", "-f", path, orig)


def act_remove_orphans(args):
    """remove-orphans: packages installed as dependencies that nothing needs."""
    need(args, 0, "remove-orphans")
    orphans = subprocess.run(["pacman", "-Qdtq"], text=True, stdout=subprocess.PIPE).stdout.split()
    if not orphans:
        print("Nothing to remove", flush=True)
        return
    run("pacman", "-Rns", "--noconfirm", "--", *orphans)


def act_clean_package_cache(args):
    """clean-package-cache: old package files, keeping the newest of each."""
    need(args, 0, "clean-package-cache")
    if not os.path.exists("/usr/bin/paccache"):
        run("pacman", "-S", "--needed", "--noconfirm", "pacman-contrib")
    run("paccache", "-rk1")
    run("paccache", "-ruk0")


VACUUM = re.compile(r"^[1-9][0-9]{0,3}(s|min|h|d|weeks|months|years)$")


def act_journal_vacuum(args):
    """journal-vacuum TIME: deletes logs older than TIME (e.g. 2weeks)."""
    need(args, 1, "journal-vacuum TIME")
    if not VACUUM.match(args[0]):
        raise Refused(f"not a time span: {args[0]!r}")
    run("journalctl", f"--vacuum-time={args[0]}")


GROUPS = {"i2c"}


def act_join_group(args):
    """join-group GROUP: adds the calling user to a known group."""
    need(args, 1, "join-group " + "|".join(sorted(GROUPS)))
    if args[0] not in GROUPS:
        raise Refused(f"not an allowed group: {args[0]!r}")
    run("usermod", "-aG", args[0], caller())


def act_snapper_setup(args):
    """snapper-setup: the root config for the system drive (btrfs)."""
    need(args, 0, "snapper-setup")
    run("snapper", "-c", "root", "create-config", "/")


def act_snapper_allow_me(args):
    """snapper-allow-me CONFIG: lets the calling user list/make/delete snapshots."""
    need(args, 1, "snapper-allow-me CONFIG")
    if not CONFIG.match(args[0]):
        raise Refused("bad config name")
    run("snapper", "-c", args[0], "set-config", f"ALLOW_USERS={caller()}", "SYNC_ACL=yes")


def act_snapper_timeline(args):
    """snapper-timeline CONFIG yes|no: hourly snapshots on or off."""
    need(args, 2, "snapper-timeline CONFIG yes|no")
    if not CONFIG.match(args[0]) or args[1] not in ("yes", "no"):
        raise Refused("bad arguments")
    run("snapper", "-c", args[0], "set-config", f"TIMELINE_CREATE={args[1]}")


def act_firewall(args):
    """firewall on|off: ufw and its service together."""
    need(args, 1, "firewall on|off")
    if args[0] == "on":
        run("systemctl", "enable", "--now", "ufw")
        run("ufw", "--force", "enable")
    elif args[0] == "off":
        run("ufw", "disable")
        run("systemctl", "disable", "--now", "ufw")
    else:
        raise Refused("on or off")


# --- Btrfs -------------------------------------------------------------------

def mounts():
    """(device, mountpoint, fstype, options) of every mount."""
    out = []
    for line in open("/proc/self/mounts"):
        dev, mp, fs, opts = line.split()[:4]
        out.append((dev, mp.replace("\\040", " "), fs, opts))
    return out


def btrfs_mount(path):
    """A path that is a mounted Btrfs filesystem's mount point."""
    if not path.startswith("/") or "\n" in path:
        raise Refused("not an absolute path")
    real = os.path.realpath(path)
    if not any(mp == real and fs == "btrfs" for _, mp, fs, _ in mounts()):
        raise Refused(f"{path} isn't a mounted Btrfs filesystem")
    return real


NAME = re.compile(r"^[A-Za-z0-9@._+-][A-Za-z0-9@._+ -]{0,63}$")


def act_btrfs_subvolumes(args):
    """btrfs-subvolumes MOUNT: lists them (id, path, mounted at)"""
    need(args, 1, "btrfs-subvolumes MOUNT")
    mp = btrfs_mount(args[0])
    mounted = {}
    for dev, m, fs, opts in mounts():
        if fs == "btrfs":
            sv = next((o[7:] for o in opts.split(",") if o.startswith("subvol=")), None)
            if sv:
                mounted.setdefault(sv.lstrip("/"), []).append(m)
    out = subprocess.run(["btrfs", "subvolume", "list", "-t", mp], text=True, stdout=subprocess.PIPE, check=True).stdout
    for line in out.splitlines()[2:]:
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit():
            sid, path = parts[0], parts[3]
            print(f"{sid}\t{path}\t{','.join(mounted.get(path, []))}")


def subvolume_target(mp, rel):
    """A subvolume below the mount point, by its path from the top level."""
    if rel.startswith("/") or ".." in rel.split("/") or "\n" in rel:
        raise Refused("bad subvolume path")
    full = os.path.join(mp, rel)
    if not os.path.isdir(full):
        raise Refused(f"{rel} isn't reachable from {mp}")
    return full


def act_btrfs_subvolume_create(args):
    """btrfs-subvolume-create MOUNT NAME: a new subvolume at the mount point's top"""
    need(args, 2, "btrfs-subvolume-create MOUNT NAME")
    mp = btrfs_mount(args[0])
    if not NAME.match(args[1]) or "/" in args[1]:
        raise Refused("bad name")
    run("btrfs", "subvolume", "create", os.path.join(mp, args[1]))


def act_btrfs_subvolume_delete(args):
    """btrfs-subvolume-delete MOUNT PATH: never one that is mounted or holds snapshots"""
    need(args, 2, "btrfs-subvolume-delete MOUNT PATH")
    mp = btrfs_mount(args[0])
    rel = args[1].strip("/")
    for dev, m, fs, opts in mounts():
        if fs == "btrfs" and any(o == f"subvol=/{rel}" or o == f"subvol={rel}" for o in opts.split(",")):
            raise Refused(f"{rel} is mounted at {m}")
    if rel.split("/")[-1] in (".snapshots", "@snapshots") or "/.snapshots/" in f"/{rel}/":
        raise Refused("snapshots are managed on the Backups page")
    if "/.refind-btrfs/" in f"/{rel}/":
        raise Refused("rEFInd's boot snapshots are managed by refind-btrfs")
    full = subvolume_target(mp, rel)
    run("btrfs", "subvolume", "delete", full)


def act_btrfs_scrub(args):
    """btrfs-scrub MOUNT start|cancel: reads everything and checks it against its checksums"""
    need(args, 2, "btrfs-scrub MOUNT start|cancel")
    mp = btrfs_mount(args[0])
    if args[1] not in ("start", "cancel"):
        raise Refused("start or cancel")
    run("btrfs", "scrub", args[1], mp)


def act_btrfs_balance(args):
    """btrfs-balance MOUNT start|cancel: compacts half-empty chunks (frees allocated space)"""
    need(args, 2, "btrfs-balance MOUNT start|cancel")
    mp = btrfs_mount(args[0])
    if args[1] == "start":
        run("btrfs", "balance", "start", "--bg", "-dusage=50", "-musage=50", mp)
    elif args[1] == "cancel":
        run("btrfs", "balance", "cancel", mp, check=False)
    else:
        raise Refused("start or cancel")


def act_btrfs_status(args):
    """btrfs-status MOUNT: scrub and balance progress"""
    need(args, 1, "btrfs-status MOUNT")
    mp = btrfs_mount(args[0])
    run("btrfs", "scrub", "status", mp, check=False)
    run("btrfs", "balance", "status", mp, check=False)


# --- Snapshots ------------------------------------------------------------------

def act_snapper_restore(args):
    """snapper-restore CONFIG NUMBER PATH: one file or folder back as it was in snapshot NUMBER"""
    need(args, 3, "snapper-restore CONFIG NUMBER PATH")
    config, number, path = args
    if not CONFIG.match(config) or not number.isdigit() or int(number) == 0:
        raise Refused("bad config or snapshot")
    if not path.startswith("/") or ".." in path.split("/") or "\n" in path:
        raise Refused("bad path")
    run("snapper", "-c", config, "undochange", f"{number}..0", path)


# --- Partitions -------------------------------------------------------------

DISK = re.compile(r"^/dev/(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|mmcblk[0-9]+|loop[0-9]+)$")


def act_move_partition(args):
    """move-partition DISK NUMBER START: moves the partition (and its data) to start at
    byte START, keeping its size. Never a mounted or system partition."""
    need(args, 3, "move-partition DISK NUMBER START")
    disk, num, start = args
    if not DISK.match(disk) or not num.isdigit() or not start.isdigit():
        raise Refused("bad arguments")
    part = f"{disk}p{num}" if disk[-1].isdigit() else f"{disk}{num}"
    if not os.path.exists(part):
        raise Refused(f"no {part}")
    # mounted (directly, through a holder like LUKS/LVM, or as swap)?
    holders = os.listdir(f"/sys/class/block/{os.path.basename(part)}/holders")
    if holders:
        raise Refused(f"{part} is in use (opened as {', '.join(holders)})")
    real = os.path.realpath(part)
    if any(os.path.realpath(dev) == real for dev, _, _, _ in mounts() if dev.startswith("/dev/")):
        raise Refused(f"{part} is mounted; unmount it first")
    if real in open("/proc/swaps").read():
        raise Refused(f"{part} is in use as swap")
    sector = 512
    try:
        sector = int(open(f"/sys/class/block/{os.path.basename(disk)}/queue/logical_block_size").read())
    except OSError:
        pass
    first = int(start) // sector
    if int(start) % (1024 * 1024):
        raise Refused("the start must be 1 MiB aligned")
    run("sfdisk", "--move-data", "--no-reread", "-N", num, disk, input=f"{first},\n")
    run("partprobe", disk, check=False)


# --- Groups ------------------------------------------------------------------

# Groups a person may be put in from the settings (hardware and service
# access); administrators (wheel) are made through the account type instead
JOINABLE = {"audio", "video", "input", "storage", "lp", "scanner", "network", "i2c", "docker", "libvirt", "kvm",
            "uucp", "rfkill", "games", "adm", "systemd-journal", "realtime", "gamemode", "plugdev"}


def act_group_member(args):
    """group-member USER GROUP add|remove"""
    need(args, 3, "group-member USER GROUP add|remove")
    user, group, op = args
    try:
        if not 1000 <= pwd.getpwnam(user).pw_uid < 60000:
            raise Refused("only people's accounts")
    except KeyError:
        raise Refused(f"no user {user}")
    if group not in JOINABLE:
        raise Refused(f"not a group the settings change: {group}")
    if op == "add":
        run("gpasswd", "-a", user, group)
    elif op == "remove":
        run("gpasswd", "-d", user, group)
    else:
        raise Refused("add or remove")


# --- boot (rEFInd on the ESP) ------------------------------------------------

REFIND = "/boot/EFI/refind"
REFIND_CONF = REFIND + "/refind.conf"
BOOT_EXPORT = "/var/lib/caelestia/boot"
KERN_BEGIN = "    # BEGIN caelestia-kernels (other kernels, managed by Settings › System › Kernels)"
KERN_END = "    # END caelestia-kernels"


def refind_lines():
    return open(REFIND_CONF).read().split("\n")


def refind_write(lines):
    """refind.conf, checked (braces balance) and atomic, the previous one kept."""
    text = "\n".join(lines)
    depth = 0
    for line in lines:
        bare = "" if line.strip().startswith("#") else line.strip()
        depth += bare.endswith("{") - (bare == "}")
        if depth < 0:
            raise Refused("refusing to write an unbalanced refind.conf")
    if depth:
        raise Refused("refusing to write an unbalanced refind.conf")
    if not DRY:
        run("cp", "-a", REFIND_CONF, REFIND_CONF + ".caelestia-prev")
    write_file(REFIND_CONF, text)
    if not DRY:
        boot_export()


def top_level(lines):
    """(index, line) of lines outside menuentry braces."""
    depth = 0
    for i, line in enumerate(lines):
        bare = "" if line.strip().startswith("#") else line.strip()
        if depth == 0:
            yield i, line
        depth += bare.endswith("{") - (bare == "}")


def set_directive(lines, key, value):
    """KEY VALUE at the top level: the last active one replaced, else added
    after the theme's include (and the overrides right after it)."""
    new = f"{key} {value}".rstrip()
    found = [i for i, l in top_level(lines) if re.match(rf"^\s*{key}(\s|$)", l)]
    if found:
        lines[found[-1]] = new
        return lines
    inc = [i for i, l in top_level(lines) if re.match(r"^\s*include\s+themes/", l)]
    at = inc[-1] + 1 if inc else len(lines)
    while at < len(lines) and lines[at].strip() and not lines[at].strip().startswith(("menuentry", "include")):
        at += 1
    lines.insert(at, new)
    return lines


TOOLS = {"shutdown", "reboot", "firmware", "about", "exit", "hidden_tags", "memtest", "shell", "gdisk", "netboot",
         "mok_tool", "bootorder", "csr_rotate", "fwupdate", "install", "apple_recovery", "windows_recovery"}
HIDEUI = {"singleuser", "hints", "arrows", "label", "badges", "safemode", "hwtest", "banner", "editor"}


def act_boot_export(args):
    """boot-export: a readable copy of rEFInd's settings and images (the ESP is
    root-only) for the settings' preview, in /var/lib/caelestia/boot."""
    boot_export()


def boot_export():
    if DRY:
        print(f"$ export {REFIND} -> {BOOT_EXPORT}", flush=True)
        return
    tmp = BOOT_EXPORT + ".new"
    subprocess.run(["rm", "-rf", tmp])
    for dirpath, dirs, files in os.walk(REFIND):
        for f in files:
            if not f.lower().endswith((".conf", ".png", ".jpg", ".jpeg", ".bmp", ".icns")):
                continue
            src = os.path.join(dirpath, f)
            if os.path.getsize(src) > 32 * 1024 * 1024:
                continue
            dst = os.path.join(tmp, os.path.relpath(src, "/boot"))
            os.makedirs(os.path.dirname(dst), mode=0o755, exist_ok=True)
            with open(src, "rb") as a, open(dst, "wb") as b:
                b.write(a.read())
            os.chmod(dst, 0o644)
    for dirpath, dirs, files in os.walk(tmp):
        os.chmod(dirpath, 0o755)
    os.makedirs(os.path.dirname(BOOT_EXPORT), mode=0o755, exist_ok=True)
    subprocess.run(["rm", "-rf", BOOT_EXPORT])
    os.replace(tmp, BOOT_EXPORT)
    print("Exported the boot menu for the preview", flush=True)


def act_boot_setup(args):
    """boot-setup: keeps the preview's copy current (a path unit watching
    rEFInd's files) and the boot menu's kernel list (a pacman hook)."""
    me = os.path.realpath(__file__)
    write_file("/etc/systemd/system/caelestia-boot-export.service",
               "[Unit]\nDescription=Caelestia settings: copy of the boot menu for its preview\n\n"
               f"[Service]\nType=oneshot\nExecStart={me} boot-export\n")
    write_file("/etc/systemd/system/caelestia-boot-export.path",
               "[Unit]\nDescription=Caelestia settings: boot menu changes\n\n"
               f"[Path]\nPathChanged={REFIND_CONF}\nPathChanged={REFIND}/themes/local\n\n"
               "[Install]\nWantedBy=multi-user.target\n")
    write_file("/etc/pacman.d/hooks/caelestia-refind-kernels.hook",
               "[Trigger]\nOperation = Install\nOperation = Remove\nOperation = Upgrade\nType = Path\n"
               "Target = usr/lib/modules/*/vmlinuz\n\n[Action]\n"
               "Description = Updating the boot menu's kernel list (Caelestia settings)\n"
               f"When = PostTransaction\nExec = {me} boot-kernels\n")
    run("systemctl", "daemon-reload")
    run("systemctl", "enable", "--now", "caelestia-boot-export.path")
    act_boot_kernels([])


def boot_value(key, vals, lines):
    """A menu setting's value as written in refind.conf, checked."""
    if key == "timeout":
        need(vals, 1, "boot-set timeout SECONDS")
        if not re.fullmatch(r"-1|[0-9]{1,3}", vals[0]) or int(vals[0]) > 600:
            raise Refused("timeout: -1 to 600")
        value = vals[0]
    elif key in ("big_icon_size", "small_icon_size"):
        need(vals, 1, f"boot-set {key} PIXELS")
        if not re.fullmatch(r"[0-9]{2,3}", vals[0]) or not 32 <= int(vals[0]) <= 512:
            raise Refused("icon size: 32 to 512")
        value = vals[0]
    elif key == "default_selection":
        need(vals, 1, "boot-set default_selection ENTRY|+")
        names = {m.group(1) for l in lines if (m := re.match(r'^\s*menuentry\s+"([^"]+)"', l))}
        if vals[0] != "+" and vals[0] not in names:
            raise Refused("not a boot menu entry")
        value = vals[0] if vals[0] == "+" else f'"{vals[0]}"'
    elif key == "showtools":
        if any(v not in TOOLS for v in vals):
            raise Refused("unknown tool")
        value = ",".join(vals)
    elif key == "hideui":
        if any(v not in HIDEUI for v in vals):
            raise Refused("unknown hideui item")
        value = ",".join(vals)
    elif key == "resolution":
        need(vals, 1, "boot-set resolution max|WIDTHxHEIGHT")
        if not re.fullmatch(r"max|[0-9]{3,4}\s?[0-9]{3,4}", vals[0].replace("x", " ")):
            raise Refused("max or WIDTHxHEIGHT")
        value = vals[0].replace("x", " ")
    else:
        raise Refused(f"unknown setting {key!r}")
    return value


def act_boot_set(args):
    """boot-set KEY [VALUE...]: one menu setting (timeout, default_selection,
    big_icon_size, small_icon_size, showtools, hideui, resolution)."""
    if not args:
        raise Refused("boot-set KEY VALUE")
    lines = refind_lines()
    refind_write(set_directive(lines, args[0], boot_value(args[0], args[1:], lines)))


FLAVOURS = ("mocha", "macchiato", "frappe", "latte")


def act_boot_theme(args):
    """boot-theme FLAVOUR: the Catppuccin flavour (mocha, macchiato, frappe, latte)."""
    need(args, 1, "boot-theme " + "|".join(FLAVOURS))
    if args[0] not in FLAVOURS:
        raise Refused("unknown flavour")
