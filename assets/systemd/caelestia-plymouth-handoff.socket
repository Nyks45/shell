[Unit]
Description=Plymouth DRM Handoff Socket for Caelestia Login
DefaultDependencies=no

[Socket]
ListenStream=/run/caelestia/plymouth-handoff.sock
# Only the session user (the one caelestia-login.service logs in) may trigger the root helper
SocketUser=hakan
SocketMode=0600
DirectoryMode=0755
Accept=no
RemoveOnStop=yes
