[Desktop Entry]
Type=Application
Name=Paint
GenericName=Drawing
Comment=Draw on, annotate and edit pictures and screenshots
Exec=/usr/lib/caelestia/caelestia-paint %F
TryExec=/usr/lib/caelestia/caelestia-paint
StartupWMClass=caelestia-paint
MimeType=image/png;image/jpeg;image/webp;image/bmp;image/gif;image/tiff;image/svg+xml;image/avif;
Icon=applications-graphics
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=paint;draw;sketch;annotate;screenshot;markup;

Actions=clipboard;

[Desktop Action clipboard]
Name=New from clipboard
Exec=/usr/lib/caelestia/caelestia-paint --clipboard
