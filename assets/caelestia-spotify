#!/usr/bin/env python3
"""Spotify for the shell's media page: log in (PKCE, no client secret), then read the library.

  caelestia-spotify login             open the browser to log in; waits for the redirect
  caelestia-spotify logout            forget the login
  caelestia-spotify status            {"loggedIn": bool, "user": name}
  caelestia-spotify playlists         your playlists (and "Liked songs" first)
  caelestia-spotify tracks <id|liked> a playlist's tracks (the first 100)
  caelestia-spotify recent            recently played tracks

The client ID (not secret: PKCE) is in ~/.config/caelestia/spotify.json; the refresh token is in
the keyring (secret-tool, service caelestia-spotify), never in a file. Output is JSON. Playback is
the Spotify app's (MPRIS OpenUri), which works without Premium.
"""
import base64
import hashlib
import http.server
import json
import os
import secrets
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "caelestia", "spotify.json")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "caelestia", "spotify-token.json")
REDIRECT = "http://127.0.0.1:47811/callback"
SCOPES = "playlist-read-private playlist-read-collaborative user-library-read user-read-recently-played user-read-private"
KEYRING = ["service", "caelestia-spotify", "kind", "refresh-token"]


def out(obj):
    print(json.dumps(obj))


def client_id():
    try:
        return json.load(open(CONFIG))["clientId"]
    except (OSError, ValueError, KeyError):
        sys.exit("no client id: set it in Settings")


def keyring_get():
    r = subprocess.run(["secret-tool", "lookup", *KEYRING], capture_output=True, text=True)
    return r.stdout.strip() or None


def keyring_set(token):
    subprocess.run(["secret-tool", "store", "--label", "Caelestia: Spotify", *KEYRING], input=token, text=True, check=True)


def keyring_clear():
    subprocess.run(["secret-tool", "clear", *KEYRING])


def token_request(data):
    req = urllib.request.Request("https://accounts.spotify.com/api/token", data=urllib.parse.urlencode(data).encode(),
                                 headers={"Content-Type": "application/x-www-form-urlencoded"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def access_token():
    """A fresh access token: the cached one (memory-only lifetime, in the cache dir, 0600) or a
    new one from the keyring's refresh token."""
    try:
        c = json.load(open(CACHE))
        if c["expires"] > time.time() + 60:
            return c["token"]
    except (OSError, ValueError, KeyError):
        pass
    refresh = keyring_get()
    if not refresh:
        sys.exit("not logged in")
    t = token_request({"grant_type": "refresh_token", "refresh_token": refresh, "client_id": client_id()})
    if t.get("refresh_token"):
        keyring_set(t["refresh_token"])
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    fd = os.open(CACHE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"token": t["access_token"], "expires": time.time() + t.get("expires_in", 3600)}, f)
    return t["access_token"]


def api(path):
    req = urllib.request.Request("https://api.spotify.com/v1" + path, headers={"Authorization": "Bearer " + access_token()})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def image(images):
    if not images:
        return ""
    # the smallest one at least 64 px
    best = sorted(images, key=lambda i: (i.get("width") or 640))
    for i in best:
        if (i.get("width") or 640) >= 64:
            return i["url"]
    return best[-1]["url"]


def track_obj(t):
    return {"name": t.get("name", ""), "uri": t.get("uri", ""), "artist": ", ".join(a["name"] for a in t.get("artists", [])),
            "image": image(t.get("album", {}).get("images", [])), "ms": t.get("duration_ms", 0)}


def c_login(_):
    cid = client_id()
    verifier = secrets.token_urlsafe(64)[:96]
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    got = {}

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if q.get("state", [""])[0] == state:
                got["code"] = q.get("code", [""])[0]
                got["error"] = q.get("error", [""])[0]
            ok = bool(got.get("code"))
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            msg = "Logged in to Spotify. You can close this tab." if ok else "Spotify login failed. You can close this tab."
            self.wfile.write(f"<html><body style='font-family:sans-serif;background:#111;color:#eee;display:grid;place-items:center;height:100vh'><h2>{msg}</h2></body></html>".encode())

        def log_message(self, *a):
            pass

    srv = http.server.HTTPServer(("127.0.0.1", 47811), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    url = "https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
        "client_id": cid, "response_type": "code", "redirect_uri": REDIRECT, "scope": SCOPES,
        "code_challenge_method": "S256", "code_challenge": challenge, "state": state})
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(600):  # five minutes
        if "code" in got:
            break
        time.sleep(0.5)
    srv.shutdown()
    if not got.get("code"):
        sys.exit("login cancelled" if got.get("error") else "login timed out")
    t = token_request({"grant_type": "authorization_code", "code": got["code"], "redirect_uri": REDIRECT,
                       "client_id": cid, "code_verifier": verifier})
    keyring_set(t["refresh_token"])
    try:
        os.remove(CACHE)
    except OSError:
        pass
    c_status(None)


def c_logout(_):
    keyring_clear()
    try:
        os.remove(CACHE)
    except OSError:
        pass
    out({"loggedIn": False})


def c_status(_):
    if not keyring_get():
        return out({"loggedIn": False})
    me = api("/me")
    out({"loggedIn": True, "user": me.get("display_name") or me.get("id", "")})


def c_playlists(_):
    res = [{"id": "liked", "name": "Liked songs", "uri": "spotify:collection:tracks", "image": "", "count": api("/me/tracks?limit=1").get("total", 0)}]
    nxt = "/me/playlists?limit=50"
    while nxt and len(res) < 200:
        page = api(nxt)
        for p in page.get("items", []):
            if p:
                res.append({"id": p["id"], "name": p["name"], "uri": p["uri"], "image": image(p.get("images") or []),
                            "count": (p.get("tracks") or p.get("items") or {}).get("total", 0)})
        n = page.get("next")
        nxt = n[len("https://api.spotify.com/v1"):] if n else None
    out(res)


def c_tracks(args):
    pid = args[0]
    if pid == "liked":
        items = api("/me/tracks?limit=50").get("items", [])
        context = "spotify:collection:tracks"
    else:
        # (Spotify's current API: /items, the track under "item"; /tracks is refused). Playlists
        # someone else owns can't be listed by apps (403): they still play as a whole
        context = f"spotify:playlist:{pid}"
        try:
            items = api(f"/playlists/{pid}/items?limit=100").get("items", [])
        except urllib.error.HTTPError as e:
            if e.code == 403:
                return out({"context": context, "tracks": [], "restricted": True})
            raise
    tracks = []
    for i in items:
        t = (i or {}).get("item") or (i or {}).get("track")
        if isinstance(t, dict) and t.get("uri") and t.get("type", "track") == "track":
            tracks.append(track_obj(t))
    out({"context": context, "tracks": tracks})


def c_recent(_):
    items = api("/me/player/recently-played?limit=30").get("items", [])
    seen, res = set(), []
    for i in items:
        t = i.get("track") or {}
        if t.get("uri") and t["uri"] not in seen:
            seen.add(t["uri"])
            res.append(track_obj(t))
    out(res)


CMDS = {"login": c_login, "logout": c_logout, "status": c_status, "playlists": c_playlists, "tracks": c_tracks, "recent": c_recent}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        sys.exit(__doc__)
    try:
        CMDS[sys.argv[1]](sys.argv[2:])
    except urllib.error.HTTPError as e:
        sys.exit(f"spotify: {e.code} {e.reason}")
    except urllib.error.URLError as e:
        sys.exit(f"spotify: {e.reason}")
