    body = json.loads(sys.stdin.read() or "{}")
    ids = [str(x).strip() for x in (body.get("ids") or []) if str(x).strip()]
    if is_mock():
        data = _load_mock()
        data["blockedServices"] = ids
        _save_mock(data)
        return _mock_status(data)
    cur = _api("GET", "/control/blocked_services/get")
    schedule = cur.get("schedule") or {"time_zone": "Local"}
    _api("PUT", "/control/blocked_services/update", {"ids": ids, "schedule": schedule})
    return _collect_live_status()


def cmd_dns_set(_args):
    body = json.loads(sys.stdin.read() or "{}")
    upstreams = [str(x).strip() for x in (body.get("upstream_dns") or []) if str(x).strip() and not str(x).strip().startswith("[/warp-svc/]")]
    if not upstreams:
        raise ValueError("At least one upstream DNS server is required")
    full_upstreams = ["[/warp-svc/]127.0.2.2"] + upstreams
    bootstrap = [str(x).strip() for x in (body.get("bootstrap_dns") or ["1.1.1.1", "9.9.9.9"]) if str(x).strip()]
    dnssec = bool(body.get("dnssec_enabled", True))
    mode = str(body.get("blocking_mode") or "default")
    if mode not in ("default", "nxdomain", "null_ip"):
        raise ValueError(f"Unsupported blocking mode: {mode!r}")
    if is_mock():
        data = _load_mock()
        data["upstreamDns"] = upstreams
        data["bootstrapDns"] = bootstrap
        data["dnssecEnabled"] = dnssec
        data["blockingMode"] = mode
        _save_mock(data)
        return _mock_status(data)
    _api("POST", "/control/dns_config", {
        "upstream_dns": full_upstreams,
        "bootstrap_dns": bootstrap,
        "dnssec_enabled": dnssec,
        "blocking_mode": mode,
    })
    return _collect_live_status()


def cmd_stats_reset(_args):
    if is_mock():
        data = _load_mock()
        data["stats"]["numDnsQueries"] = 0
        data["stats"]["numBlockedFiltering"] = 0
        data["stats"]["blockedPercent"] = 0.0
        data["stats"]["topBlockedDomains"] = []
        data["stats"]["topQueriedDomains"] = []
        data["stats"]["dnsQueriesSeries"] = [0] * 24
        data["stats"]["blockedSeries"] = [0] * 24
        _save_mock(data)
        return _mock_status(data)
    _api("POST", "/control/stats_reset")
    return _collect_live_status()


def cmd_querylog_clear(_args):
    if is_mock():
        data = _load_mock()
        data["queryLog"] = []
        _save_mock(data)
        return {"items": []}
    _api("POST", "/control/querylog_clear")
    return {"items": []}


def build_parser():
    p = argparse.ArgumentParser(description="Caelestia Ad Blocker helper")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status").set_defaults(func=cmd_status)

    ql = sub.add_parser("querylog")
    ql.add_argument("--search", default="")
    ql.add_argument("--filter", choices=["all", "blocked", "allowed"], default="all")
    ql.add_argument("--limit", type=int, default=100)
    ql.set_defaults(func=cmd_querylog)

    pr = sub.add_parser("protection")
    pr.add_argument("state", choices=["on", "off"])
    pr.add_argument("duration_ms", nargs="?", type=int, default=0)
    pr.set_defaults(func=cmd_protection)

    ft = sub.add_parser("filter-toggle")
    ft.add_argument("url")
    ft.add_argument("name")
    ft.add_argument("state", choices=["on", "off"])
    ft.set_defaults(func=cmd_filter_toggle)

    fa = sub.add_parser("filter-add")
    fa.add_argument("url")
    fa.add_argument("name", nargs="?", default="")
    fa.set_defaults(func=cmd_filter_add)

    fr = sub.add_parser("filter-remove")
    fr.add_argument("url")
    fr.set_defaults(func=cmd_filter_remove)

    sub.add_parser("filter-refresh").set_defaults(func=cmd_filter_refresh)
    sub.add_parser("rules-set").set_defaults(func=cmd_rules_set)

    qr = sub.add_parser("quick-rule")
    qr.add_argument("mode", choices=["block", "allow", "clear"])
    qr.add_argument("domain")
    qr.set_defaults(func=cmd_quick_rule)

    sf = sub.add_parser("safety")
    sf.add_argument("kind", choices=["safebrowsing", "parental", "safesearch"])
    sf.add_argument("state", choices=["on", "off"])
    sf.set_defaults(func=cmd_safety)

    sub.add_parser("blocked-services-set").set_defaults(func=cmd_blocked_services_set)
    sub.add_parser("dns-set").set_defaults(func=cmd_dns_set)
    sub.add_parser("stats-reset").set_defaults(func=cmd_stats_reset)
    sub.add_parser("querylog-clear").set_defaults(func=cmd_querylog_clear)
    return p


def main(argv):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        out = args.func(args)
        print(json.dumps(out))
        return 0
    except Exception as e:
        print(str(e), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
