LUTRIS_DATA = os.path.join(HOME, ".local/share/lutris")


def lutris_yaml():
    try:
        import yaml
        return yaml
    except ImportError:
        return None


def lutris_config_path(configpath):
    for base in (os.path.join(LUTRIS_DATA, "games"), os.path.join(HOME, ".config/lutris/games")):
        p = os.path.join(base, configpath + ".yml")
        if os.path.exists(p):
            return p
    return os.path.join(LUTRIS_DATA, "games", configpath + ".yml")


def lutris_choices():
    ch = [["", "Lutris's default"]]
    for d in sorted(glob.glob(os.path.join(TARGETS["lutris"], "*"))):
        if os.path.isdir(d):
            ch.append([os.path.basename(d), os.path.basename(d)])
    for d in sorted(glob.glob(os.path.join(TARGETS["steam"], "*")) + glob.glob(os.path.join(SYSTEM_STEAM, "*"))):
        if os.path.isdir(d) and os.path.basename(d) not in [c[0] for c in ch]:
            ch.append([os.path.basename(d), os.path.basename(d)])
    return ch


def lutris_games():
    db = os.path.join(LUTRIS_DATA, "pga.db")
    yaml = lutris_yaml()
    info = {"installed": os.path.exists(db) and yaml is not None, "running": running("lutris"),
            "choices": lutris_choices(), "perf": True}
    if not info["installed"]:
        return [], info
    games = []
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
        rows = con.execute("SELECT id, name, slug, runner, configpath, directory, lastplayed, playtime "
                           "FROM games WHERE installed = 1").fetchall()
        con.close()
    except sqlite3.Error:
        return [], info
    for gid, name, slug, runner, configpath, directory, lastplayed, playtime in rows:
        cfg = {}
        if configpath:
            try:
                cfg = yaml.safe_load(open(lutris_config_path(configpath))) or {}
            except (OSError, yaml.YAMLError):
                cfg = {}
        system = cfg.get("system") or {}
        env = system.get("env") or {}
        cover = next((c for c in (os.path.join(LUTRIS_DATA, "coverart", f"{slug}.jpg"),
                                  os.path.join(LUTRIS_DATA, "banners", f"{slug}.jpg")) if os.path.exists(c)), "")
        games.append({"key": f"lutris:{gid}", "launcher": "lutris", "id": str(gid), "title": name, "cover": cover,
                      "runner": runner or "", "proton": (cfg.get("wine") or {}).get("version", "") if runner == "wine" else None,
                      "env": {k: str(v) for k, v in env.items() if k in ENV_KEYS},
                      "otherEnv": [f"{k}={v}" for k, v in env.items() if k not in ENV_KEYS],
                      "mangohud": bool(system.get("mangohud")), "perf": system.get("prefix_command") == PERF,
                      "args": str((cfg.get("game") or {}).get("args", "") or ""),
                      "lastPlayed": int(lastplayed or 0), "state": "installed", "path": directory or "",
                      "play": ["lutris", f"lutris:rungameid/{gid}"], "removable": True})
    return games, info


def lutris_write(path, cfg):
    yaml = lutris_yaml()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(yaml.safe_dump(cfg, default_flow_style=False))
    os.replace(tmp, path)


def lutris_set(gid, req):
    env_changes, proton = check_changes(req)
    yaml = lutris_yaml()
    con = sqlite3.connect(os.path.join(LUTRIS_DATA, "pga.db"), timeout=5)
    row = con.execute("SELECT configpath, runner FROM games WHERE id = ?", (int(gid),)).fetchone()
    con.close()
    if not row or not row[0]:
        sys.exit("no such Lutris game")
    path = lutris_config_path(row[0])
    cfg = (yaml.safe_load(open(path)) if os.path.exists(path) else {}) or {}
    system = cfg.setdefault("system", {}) or {}
    cfg["system"] = system
    if env_changes:
        env = dict(system.get("env") or {})
        for k, v in env_changes.items():
            if v is None:
                env.pop(k, None)
            else:
                env[k] = v
        system["env"] = env
    if "mangohud" in req:
        if req["mangohud"]:
            system["mangohud"] = True
        else:
            system.pop("mangohud", None)
    if "perf" in req:
        if req["perf"]:
            system["prefix_command"] = PERF
        elif system.get("prefix_command") == PERF:
            system.pop("prefix_command")
    if proton is not None:
        if row[1] != "wine":
            sys.exit("this game doesn't run with Wine/Proton")
        wine = cfg.setdefault("wine", {}) or {}
        cfg["wine"] = wine
        if proton:
            wine["version"] = proton
        else:
            wine.pop("version", None)
    lutris_write(path, cfg)


