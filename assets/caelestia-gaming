def heroic_set(app, req):
    env_changes, proton = check_changes(req)
    if running("heroic"):
        sys.exit("close Heroic first (it keeps its settings in memory)")
    base = heroic_dir()
    if not base or not re.fullmatch(r"[A-Za-z0-9_.-]+", app):
        sys.exit("no such Heroic game")
    p = os.path.join(base, "GamesConfig", f"{app}.json")
    data = json.load(open(p)) if os.path.exists(p) else {}
    cfg = data.setdefault(app, {})
    if env_changes:
        envs = [e for e in cfg.get("enviromentOptions", []) if isinstance(e, dict)]
        pairs = apply_env([(e.get("key"), str(e.get("value", "")), "") for e in envs], env_changes)
        cfg["enviromentOptions"] = [{"key": k, "value": v} for k, v, _ in pairs]
    if "mangohud" in req:
        cfg["showMangohud"] = bool(req["mangohud"])
    if "perf" in req:
        wr = [w for w in cfg.get("wrapperOptions", []) if isinstance(w, dict) and w.get("exe") != PERF]
        cfg["wrapperOptions"] = ([{"exe": PERF, "args": ""}] if req["perf"] else []) + wr
    if proton is not None:
        if proton:
            if not os.path.exists(os.path.join(proton, "proton")):
                sys.exit("not a Proton folder")
            cfg["wineVersion"] = {"bin": os.path.join(proton, "proton"), "name": f"Proton - {os.path.basename(proton)}", "type": "proton"}
        else:
            cfg.pop("wineVersion", None)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    if os.path.exists(p):
        shutil.copy2(p, p + ".caelestia-bak")
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, p)


