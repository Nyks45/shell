def c_library(args):
    games, launchers = [], {}
    for name, (read, _) in LAUNCHERS.items():
        try:
            g, info = read()
        except Exception as e:  # one launcher's odd file mustn't hide the others
            g, info = [], {"installed": False, "error": str(e)}
        games += g
        launchers[name] = info
    games.sort(key=lambda g: (-g.get("lastPlayed", 0), g["title"].lower()))
    out({"games": games, "launchers": launchers, "stamp": stamp()})


def stamp():
    """mtimes of what changes when a game is added, removed or changed in a launcher
    (a folder's mtime changes when a file is added or removed in it)."""
    paths = [os.path.join(STEAM_ROOT, "config/config.vdf"), os.path.join(LUTRIS_DATA, "pga.db"),
             os.path.join(LUTRIS_DATA, "games"), FAUGUS_GAMES, os.path.dirname(FAUGUS_GAMES)]
    paths += [os.path.join(l, "steamapps") for l in steam_libraries()]
    paths += glob.glob(os.path.join(STEAM_ROOT, "userdata/*/config/localconfig.vdf"))
    hd = heroic_dir()
    if hd:
        paths += [os.path.join(hd, f) for f in ("legendaryConfig/legendary/installed.json", "gog_store/installed.json",
                                                 "sideload_apps/library.json", "GamesConfig")]
    # and which launchers are open (their games' settings can't change meanwhile)
    open_now = [running("steam"), running("lutris"), faugus_running(), running("heroic")]
    return hashlib.sha1(repr([(p, file_mtime(p)) for p in paths] + open_now).encode()).hexdigest()[:16]


