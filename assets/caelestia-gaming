def faugus_choices():
    ch = []
    if glob.glob(os.path.join(SYSTEM_STEAM, "proton-cachyos*")):
        ch.append(["Proton-CachyOS (System)", "Proton-CachyOS (system package)"])
    for d in sorted(glob.glob(os.path.join(TARGETS["steam"], "*"))):
        if os.path.isdir(d):
            ch.append([os.path.basename(d), os.path.basename(d)])
    ch.append(["Linux-Native", "Linux game (no Proton)"])
    return ch


def faugus_load():
    try:
        g = json.load(open(FAUGUS_GAMES))
        return g if isinstance(g, list) else []
    except (OSError, ValueError):
        return []


def faugus_save(games):
    os.makedirs(os.path.dirname(FAUGUS_GAMES), exist_ok=True)
    if os.path.exists(FAUGUS_GAMES):
        shutil.copy2(FAUGUS_GAMES, FAUGUS_GAMES + ".caelestia-bak")
    tmp = FAUGUS_GAMES + ".tmp"
    with open(tmp, "w") as f:
        json.dump(games, f, indent=4, ensure_ascii=False)
    os.replace(tmp, FAUGUS_GAMES)


def faugus_split(args):
    env, rest = [], []
    for raw, val in [w for line in (args or "").splitlines() for w in shell_words(line)]:
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", val, re.S)
        (env.append((m.group(1), m.group(2), raw)) if m else rest.append(raw))
    return env, rest


def faugus_games():
    cfg = {}
    try:
        cfg = json.load(open(FAUGUS_CONFIG))
    except (OSError, ValueError):
        pass
    info = {"installed": bool(shutil.which("faugus-launcher")), "running": faugus_running(), "choices": faugus_choices(),
            "default": cfg.get("default-runner", ""), "perf": False}
    games = []
    for g in faugus_load():
        if not isinstance(g, dict) or not g.get("gameid"):
            continue
        env, rest = faugus_split(g.get("launch_arguments", ""))
        cover = g.get("cover") or g.get("icon") or ""
        games.append({"key": f"faugus:{g['gameid']}", "launcher": "faugus", "id": g["gameid"], "title": g.get("title", g["gameid"]),
                      "cover": cover if cover and os.path.exists(os.path.expanduser(cover)) else "",
                      "proton": g.get("runner", ""), "env": {k: v for k, v, _ in env if k in ENV_KEYS},
                      "otherEnv": [raw for k, _, raw in env if k not in ENV_KEYS] + rest,
                      "mangohud": bool(g.get("mangohud")), "perf": None, "args": g.get("game_arguments", ""),
                      "lastPlayed": int(g.get("last_played") or 0) if str(g.get("last_played") or "0").isdigit() else 0,
                      "state": "hidden" if g.get("hidden") else "installed", "path": g.get("path", ""),
                      "play": ["faugus-launcher", "--game", g["gameid"]], "removable": True})
    return games, info


def faugus_set(gid, req):
    env_changes, proton = check_changes(req)
    if faugus_running():
        sys.exit("close Faugus first (it rewrites its game list from memory)")
    games = faugus_load()
    g = next((x for x in games if isinstance(x, dict) and x.get("gameid") == gid), None)
    if not g:
        sys.exit("no such Faugus game")
    if env_changes:
        env, rest = faugus_split(g.get("launch_arguments", ""))
        env = apply_env(env, env_changes)
        g["launch_arguments"] = " ".join([raw or f"{k}={shlex.quote(v)}" for k, v, raw in env] + rest)
    if "mangohud" in req:
        g["mangohud"] = True if req["mangohud"] else ""
    if proton is not None:
        g["runner"] = proton
    faugus_save(games)


