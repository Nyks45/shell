def c_game_add(args):
    """{launcher: steam|faugus|lutris, title, exe, proton, args}: a Windows game (or a Linux one)."""
    req = json.load(sys.stdin)
    title, exe = str(req.get("title", "")).strip(), os.path.expanduser(str(req.get("exe", "")))
    launcher, proton, gargs = req.get("launcher"), str(req.get("proton", "")), str(req.get("args", ""))
    if not title or len(title) > 200 or "\n" in title:
        sys.exit("a name is needed")
    if not os.path.isfile(exe):
        sys.exit("the game's program wasn't found")
    if not re.fullmatch(r"[A-Za-z0-9 ._()+/-]{0,200}", proton) or "\n" in gargs:
        sys.exit("not a version name")
    slug = re.sub(r"\s+", "-", re.sub(r"[^\w\s-]", "", title.strip().lower())) or "game"
    if launcher == "faugus":
        if faugus_running():
            sys.exit("close Faugus first (it rewrites its game list from memory)")
        games = faugus_load()
        ids = {g.get("gameid") for g in games if isinstance(g, dict)}
        gid, n = slug, 2
        while gid in ids:
            gid, n = f"{slug}-{n}", n + 1
        cfg = {}
        try:
            cfg = json.load(open(FAUGUS_CONFIG))
        except (OSError, ValueError):
            pass
        prefix_base = os.path.expanduser(cfg.get("default-prefix") or os.path.join(HOME, "Faugus"))
        g = {f: "" for f in FAUGUS_FIELDS}
        g.update({"gameid": gid, "title": title, "path": exe, "prefix": os.path.join(prefix_base, gid),
                  "game_arguments": gargs,
                  "runner": (proton or cfg.get("default-runner", "")) if WINDOWS_EXE.search(exe) else "Linux-Native",
                  "playtime": 0, "hidden": False, "no_sleep": False, "category": False})
        games.append(g)
        faugus_save(games)
        print(f"Added {title} to Faugus", flush=True)
    elif launcher == "steam":
        if running("steam"):
            sys.exit("close Steam first (it rewrites its settings when it quits)")
        user = steam_user()
        if not user:
            sys.exit("no Steam user found (sign in to Steam once)")
        items = shortcuts_load(user)
        sc = vdf_find_b(items)
        exe_q = f'"{exe}"'
        # Steam's own id for a shortcut: crc32 of exe and name, top bit set
        appid = (zlib.crc32((exe_q + title).encode()) & 0xFFFFFFFF) | 0x80000000
        if any(isinstance(e, list) and sc_appid(e) == appid for _, e in sc):
            sys.exit("it's in Steam already")
        signed = appid - (1 << 32)
        entry = [["appid", ("i32", signed)], ["AppName", title], ["Exe", exe_q],
                 ["StartDir", f'"{os.path.dirname(exe)}/"'], ["icon", ""], ["ShortcutPath", ""], ["LaunchOptions", gargs],
                 ["IsHidden", ("i32", 0)], ["AllowDesktopConfig", ("i32", 1)], ["AllowOverlay", ("i32", 1)],
                 ["OpenVR", ("i32", 0)], ["Devkit", ("i32", 0)], ["DevkitGameID", ""], ["DevkitOverrideAppID", ("i32", 0)],
                 ["LastPlayTime", ("i32", 0)], ["FlatpakAppID", ""], ["tags", []]]
        idx = max([int(k) for k, _ in sc if k.isdigit()] + [-1]) + 1
        sc.append([str(idx), entry])
        shortcuts_save(user, items)
        # A Windows program needs Proton chosen for it (Steam's default doesn't cover shortcuts)
        if WINDOWS_EXE.search(exe):
            name = proton or steam_default()[0] or "proton_experimental"
            p = os.path.join(STEAM_ROOT, "config/config.vdf")
            t = vdf_read(p)
            m = vdf_find(t, "InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping", create=True)
            m.append([str(appid), [["name", name], ["config", ""], ["priority", "250"]]])
            vdf_write(p, t)
        print(f"Added {title} to Steam", flush=True)
    elif launcher == "lutris":
        yaml = lutris_yaml()
        db = os.path.join(LUTRIS_DATA, "pga.db")
        if not yaml or not os.path.exists(db):
            sys.exit("Lutris isn't set up (open it once)")
        now = int(time.time())
        configpath = f"{slug}-{now}"
        prefix = os.path.join(HOME, "Games", slug)
        windows = bool(WINDOWS_EXE.search(exe))
        cfg = {"game": {"exe": exe, "prefix": prefix} if windows else {"exe": exe}, "system": {}}
        if windows:
            cfg["wine"] = {"version": proton} if proton else {}
        if gargs:
            cfg["game"]["args"] = gargs
        lutris_write(os.path.join(LUTRIS_DATA, "games", configpath + ".yml"), cfg)
        con = sqlite3.connect(db, timeout=5)
        con.execute("INSERT INTO games (name, sortname, slug, installer_slug, parent_slug, platform, runner, executable, "
                    "directory, updated, lastplayed, installed, installed_at, year, configpath, has_custom_banner, "
                    "has_custom_icon, has_custom_coverart_big, playtime, service, service_id) "
                    "VALUES (?, '', ?, '', '', ?, ?, '', ?, ?, 0, 1, ?, NULL, ?, 0, 0, 0, 0, '', '')",
                    (title, slug, "Windows" if windows else "Linux", "wine" if windows else "linux",
                     prefix if windows else os.path.dirname(exe), time.strftime("%Y-%m-%d %H:%M:%S"), now, configpath))
        con.commit()
        con.close()
        print(f"Added {title} to Lutris", flush=True)
    else:
        sys.exit("games can be added to Steam, Faugus or Lutris")


def c_game_remove(args):
    launcher, _, gid = args[0].partition(":")
    if launcher == "faugus":
        if faugus_running():
            sys.exit("close Faugus first (it rewrites its game list from memory)")
        games = faugus_load()
        left = [g for g in games if not (isinstance(g, dict) and g.get("gameid") == gid)]
        if len(left) == len(games):
            sys.exit("no such Faugus game")
        faugus_save(left)
    elif launcher == "lutris":
        con = sqlite3.connect(os.path.join(LUTRIS_DATA, "pga.db"), timeout=5)
        n = con.execute("UPDATE games SET installed = 0 WHERE id = ?", (int(gid),)).rowcount
        con.commit()
        con.close()
        if not n:
            sys.exit("no such Lutris game")
    elif launcher == "steam":
        if running("steam"):
            sys.exit("close Steam first (it rewrites its settings when it quits)")
        user = steam_user()
        items = shortcuts_load(user) if user else [["shortcuts", []]]
        sc = vdf_find_b(items)
        left = [it for it in sc if not (isinstance(it[1], list) and str(sc_appid(it[1])) == gid)]
        if len(left) == len(sc):
            sys.exit("only games added to Steam (non-Steam games) can be taken off here")
        # Renumbered 0, 1, ... as Steam writes them
        sc[:] = [[str(i), e] for i, (_, e) in enumerate(left)]
        shortcuts_save(user, items)
        p = os.path.join(STEAM_ROOT, "config/config.vdf")
        try:
            t = vdf_read(p)
            m = vdf_find(t, "InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping")
            if m is not None and any(k == gid for k, _ in m):
                m[:] = [it for it in m if it[0] != gid]
                vdf_write(p, t)
        except (OSError, ValueError):
            pass
    else:
        sys.exit("only games added to Steam, Faugus or Lutris can be taken off here")
    print(f"Removed {args[0]} from the list", flush=True)


# --- DLSS multi frame generation unlock ------------------------------------------------
# MFG Unlocker (github.com/dashdogy/MFG-Unlocker, MIT): one DLL that, put next to a game's
# exe under a name the game loads early (version.dll...), lets the game's own DLSS Frame
# Generation run at 3x/4x on RTX 20-40 (NVIDIA allows 2x there). Only for games that
# already have DLSS FG (Streamline); never for games with anti-cheat. Under Proton the
# game needs a Wine override to load it (NAME=n,b): Steam/Faugus/Heroic in the game's
# WINEDLLOVERRIDES, Lutris in its Wine overrides. What was put where is kept in state.json,
# so taking it away removes exactly that (and leaves a file that changed since).

MFG_REPO = "dashdogy/MFG-Unlocker"
MFG_DIR = os.path.join(HOME, ".local/share/caelestia/mfg-unlocker")
MFG_STATE = os.path.join(MFG_DIR, "state.json")
MFG_NAMES = ["version.dll", "winmm.dll", "dinput8.dll"]  # in the unlocker's order of what usually works
MFG_SETTINGS = "RTXMFG-Universal.json"
MFG_MODES = ["follow", "2", "3", "4"]
FG_FILES = {"nvngx_dlssg.dll", "sl.dlss_g.dll"}
ANTICHEAT = re.compile(r"^(easyanticheat.*|battleye|beservice.*|be_.*\.dll|start_protected_game\.exe|eac_launcher\.exe|"
                       r"vgc\.exe|mhyprot.*|xigncode.*|gameguard|npgamemon\.des|pnkbstr.*|pbsvc.*)$", re.I)
NOT_GAME_EXE = re.compile(r"(unins|setup|install|redist|vc_?redist|dxsetup|directx|crash|report|launcher|helper|"
                          r"easyanticheat|battleye|beservice|unitycrash|ue4prereq|prereq|dotnet|vcredist|cefprocess|"
                          r"overlay|update|patcher|benchmark)", re.I)
SKIP_DIRS = {"windows", "users", "programdata", "compatdata", "shadercache", "_commonredist", "__pycache__", "redist",
             "redistributables", "directx", "support", "dotnet", "vcredist"}


