def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(1 << 20):
            h.update(chunk)
    return h.hexdigest()


def pe_version(path):
    """A Windows DLL's file version (VS_FIXEDFILEINFO), e.g. 310.9.16.0, or ""."""
    try:
        data = open(path, "rb").read()
    except OSError:
        return ""
    sig, i = struct.pack("<II", 0xFEEF04BD, 0x00010000), -1  # signature + structure version 1.0
    while (i := data.find(sig, i + 1)) >= 0:  # the signature alone also occurs in code
        if i + 16 <= len(data):
            ms, ls = struct.unpack_from("<II", data, i + 8)
            if ms:
                return f"{ms >> 16}.{ms & 0xFFFF}.{ls >> 16}.{ls & 0xFFFF}"
    return ""


def walk(root, depth=7):
    """(dir, files) under root, skipping Wine's own folders, redists and shader caches."""
    root = root.rstrip("/")
    base = root.count("/")
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x.lower() not in SKIP_DIRS and not os.path.islink(os.path.join(d, x))]
        if d.count("/") - base >= depth:
            dirs[:] = []
        yield d, files


def game_root(g):
    p = g.get("path") or ""
    if p and os.path.isfile(p):
        p = os.path.dirname(p)
    return p if p and os.path.isdir(p) and os.path.realpath(p) != os.path.realpath(HOME) else ""


def mfg_scan(g):
    """For one game: its DLSS FG file, anti-cheat, and the folder of the real game exe (largest exe)."""
    root = game_root(g)
    if not root:
        return None
    fg, anticheat, best = None, [], (0, "")
    for d, files in walk(root):
        if ANTICHEAT.match(os.path.basename(d)):
            anticheat.append(os.path.relpath(d, root))
        for f in files:
            low = f.lower()
            if low in FG_FILES and (fg is None or low == "nvngx_dlssg.dll"):
                fg = os.path.join(d, f)
            if ANTICHEAT.match(f):
                anticheat.append(os.path.relpath(os.path.join(d, f), root))
            if low.endswith(".exe") and not NOT_GAME_EXE.search(f):
                try:
                    size = os.path.getsize(os.path.join(d, f))
                except OSError:
                    continue
                if size > best[0]:
                    best = (size, d)
    if not fg:
        return None
    dlssg = os.path.join(os.path.dirname(fg), "nvngx_dlssg.dll")
    return {"root": root, "fg": fg, "fgVersion": pe_version(dlssg) if os.path.exists(dlssg) else "",
            "exeDir": best[1], "anticheat": anticheat[:3]}


def overrides_split(text):
    """WINEDLLOVERRIDES "a,b=n,b;c=n" -> [[names], mode]."""
    res = []
    for part in (text or "").split(";"):
        if "=" in part:
            names, mode = part.split("=", 1)
            res.append([[n for n in names.split(",") if n], mode])
        elif part.strip():
            res.append([[n for n in part.split(",") if n], ""])
    return res


def overrides_join(items):
    return ";".join(",".join(n) + ("=" + m if m else "") for n, m in items if n)


def game_env(g, key):
    """A game's own value for an environment variable (its launch options), or None."""
    if key in (g.get("env") or {}):
        return g["env"][key]
    for raw in g.get("otherEnv") or []:
        for _, val in shell_words(raw):
            k, eq, v = val.partition("=")
            if eq and k == key:
                return v
    return None


def mfg_override(g, name, add):
    """Add NAME=n,b to (or take it off) the game's Wine DLL overrides. Returns whether it changed."""
    base = name[:-4].lower()
    launcher, _, gid = g["key"].partition(":")
    if launcher == "lutris":
        yaml = lutris_yaml()
        con = sqlite3.connect(os.path.join(LUTRIS_DATA, "pga.db"), timeout=5)
        row = con.execute("SELECT configpath FROM games WHERE id = ?", (int(gid),)).fetchone()
        con.close()
        if not row or not row[0]:
            sys.exit("no such Lutris game")
        path = lutris_config_path(row[0])
        cfg = (yaml.safe_load(open(path)) if os.path.exists(path) else {}) or {}
        wine = cfg.setdefault("wine", {}) or {}
        cfg["wine"] = wine
        ov = dict(wine.get("overrides") or {})
        if add == (ov.get(base) == "n,b"):
            return False
        if add:
            ov[base] = "n,b"
        else:
            ov.pop(base, None)
        if ov:
            wine["overrides"] = ov
        else:
            wine.pop("overrides", None)
        lutris_write(path, cfg)
        return True
    items = overrides_split(game_env(g, "WINEDLLOVERRIDES"))
    has = any(base in [n.lower() for n in names] and mode == "n,b" for names, mode in items)
    if add == has:
        return False
    if add:
        items.append([[base], "n,b"])
    else:
        items = [[[n for n in names if n.lower() != base], mode] if mode == "n,b" else [names, mode]
                 for names, mode in items]
    val = overrides_join(items)
    LAUNCHERS[launcher][1](gid, {"env": {"WINEDLLOVERRIDES": val or None}})
    return True


def mfg_write_mode(exe_dir, mode):
    """The unlocker's own settings file next to the exe: follow the game, or a fixed multiplier."""
    p = os.path.join(exe_dir, MFG_SETTINGS)
    try:
        cur = json.load(open(p))
        if not isinstance(cur, dict):
            cur = {}
    except (OSError, ValueError):
        cur = {"version": 13}
    if mode == "follow":
        cur.update({"followGame": True, "mode": "follow"})
    else:
        cur.update({"followGame": False, "mode": "fixed", "multiplier": int(mode)})
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cur, f, separators=(",", ":"))
    os.replace(tmp, p)


def mfg_dll(s):
    p = os.path.join(MFG_DIR, s.get("tag", ""), "MFGUnlocker.dll")
    return p if s.get("tag") and os.path.exists(p) else ""


def library_games():
    games = []
    for name, (read, _) in LAUNCHERS.items():
        try:
            games += read()[0]
        except Exception:
            pass
    return games


def c_mfg(args):
    s = mfg_state()
    rows = []
    for g in library_games():
        info = mfg_scan(g)
        inst = s["games"].get(g["key"])
        if not info and not inst:
            continue
        rows.append({"key": g["key"], "title": g["title"], "launcher": g["launcher"],
                     "fgVersion": (info or {}).get("fgVersion", ""),
                     "exeDir": (inst or {}).get("dir") or (info or {}).get("exeDir", ""),
                     "anticheat": (info or {}).get("anticheat", []),
                     "installed": bool(inst and os.path.exists(os.path.join(inst["dir"], inst["name"]))),
                     "name": (inst or {}).get("name", ""), "found": bool(info)})
    rows.sort(key=lambda r: r["title"].lower())
    out({"tag": s.get("tag", "") if mfg_dll(s) else "", "mode": s["mode"], "games": rows})


def c_mfg_fetch(args):
    rel = json.loads(fetch(f"https://api.github.com/repos/{MFG_REPO}/releases/latest"))
    tag = rel.get("tag_name", "")
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,40}", tag):
        sys.exit("no release found")
    assets = {a["name"]: a for a in rel.get("assets", [])}
    zname = next((n for n in assets if re.fullmatch(r"MFGUnlocker-.*\.zip", n)), None)
    if not zname or "SHA256SUMS.txt" not in assets:
        sys.exit("that release has no download with checksums")
    sums = {}
    for line in fetch(assets["SHA256SUMS.txt"]["browser_download_url"]).decode(errors="replace").splitlines():
        parts = line.split()
        if len(parts) == 2:
            sums[parts[1].lstrip("*")] = parts[0].lower()
    if zname not in sums or "MFGUnlocker.dll" not in sums:
        sys.exit("no checksum published for it: not downloaded")
    s = mfg_state()
    os.makedirs(MFG_DIR, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="mfg-", dir=MFG_DIR) as tmp:
        arch = os.path.join(tmp, zname)
        print(f"Downloading {zname} ({assets[zname]['size'] // 1048576} MB)", flush=True)
        req = urllib.request.Request(assets[zname]["browser_download_url"], headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=60) as r, open(arch, "wb") as f:
            shutil.copyfileobj(r, f)
        if sha256(arch) != sums[zname]:
            sys.exit("the download doesn't match its checksum: not used")
        import zipfile
        with zipfile.ZipFile(arch) as z:
            member = next((m for m in z.namelist() if os.path.basename(m) == "MFGUnlocker.dll"), None)
            if not member:
                sys.exit("no MFGUnlocker.dll in the download")
            dll = os.path.join(tmp, "MFGUnlocker.dll")
            with z.open(member) as src, open(dll, "wb") as dst:
                shutil.copyfileobj(src, dst)
        if sha256(dll) != sums["MFGUnlocker.dll"]:
            sys.exit("the DLL doesn't match its checksum: not used")
        dest = os.path.join(MFG_DIR, tag)
        os.makedirs(dest, exist_ok=True)
        os.replace(dll, os.path.join(dest, "MFGUnlocker.dll"))
    print(f"Checksum OK: MFG Unlocker {tag}", flush=True)
    old = s.get("tag")
    s["tag"], s["sha256"] = tag, sums["MFGUnlocker.dll"]
    # Games that have it get the new one (only where the file is still the one put there)
    for key, inst in s["games"].items():
        p = os.path.join(inst["dir"], inst["name"])
        if os.path.exists(p) and sha256(p) == inst.get("sha256"):
            shutil.copyfile(os.path.join(MFG_DIR, tag, "MFGUnlocker.dll"), p)
            inst["sha256"], inst["tag"] = s["sha256"], tag
            print(f"Updated in {key}", flush=True)
    mfg_save(s)
    if old and old != tag and not any(i.get("tag") == old for i in s["games"].values()):
        shutil.rmtree(os.path.join(MFG_DIR, old), ignore_errors=True)


def c_mfg_set(args):
    key, on = args[0], args[1] == "on"
    s = mfg_state()
    g = next((x for x in library_games() if x["key"] == key), None)
    if not g:
        sys.exit("unknown game")
    if g["launcher"] in ("steam", "faugus", "heroic") and running({"steam": "steam", "heroic": "heroic"}.get(g["launcher"], "")) \
            or (g["launcher"] == "faugus" and faugus_running()):
        sys.exit(f"close {g['launcher'].capitalize()} first (it rewrites its settings when it quits)")
    inst = s["games"].get(key)
    if on:
        dll = mfg_dll(s)
        if not dll:
            sys.exit("download MFG Unlocker first")
        if inst and os.path.exists(os.path.join(inst["dir"], inst["name"])):
            print("Already in this game", flush=True)
            return
        info = mfg_scan(g)
        if not info:
            sys.exit("this game has no DLSS Frame Generation (the unlocker only changes the game's own)")
        if info["anticheat"]:
            sys.exit("this game has anti-cheat (" + ", ".join(info["anticheat"]) + "): a mod DLL can get the account banned")
        d = info["exeDir"]
        if not d:
            sys.exit("couldn't find the game's exe")
        present = {f.lower() for f in os.listdir(d)}
        name = next((n for n in MFG_NAMES if n not in present), None)
        if not name:
            sys.exit("version.dll, winmm.dll and dinput8.dll are all taken by the game or other mods")
        shutil.copyfile(dll, os.path.join(d, name))
        added = mfg_override(g, name, True)
        mfg_write_mode(d, s["mode"])
        s["games"][key] = {"dir": d, "name": name, "sha256": s["sha256"], "tag": s["tag"], "override": added,
                           "title": g["title"]}
        mfg_save(s)
        print(f"Put in {d} as {name}", flush=True)
    else:
        if not inst:
            print("Not in this game", flush=True)
            return
        p = os.path.join(inst["dir"], inst["name"])
        kept = False
        if os.path.exists(p):
            if sha256(p) == inst.get("sha256"):
                os.remove(p)
            else:
                kept = True
        if inst.get("override"):
            mfg_override(g, inst["name"], False)
        del s["games"][key]
        mfg_save(s)
        print(f"Kept {p}: it changed since it was put there" if kept else f"Taken out of {inst['dir']}", flush=True)


def c_mfg_mode(args):
    mode = args[0]
    if mode not in MFG_MODES:
        sys.exit("follow, 2, 3 or 4")
    s = mfg_state()
    s["mode"] = mode
    for inst in s["games"].values():
        if os.path.isdir(inst["dir"]):
            mfg_write_mode(inst["dir"], mode)
    mfg_save(s)
    print(f"Mode {mode}", flush=True)


