def vdf_name(d):
    """The tool's internal name (what launchers select) from compatibilitytool.vdf, else the folder."""
    try:
        m = re.search(r'"compat_tools"\s*\{\s*"([^"]+)"', open(os.path.join(d, "compatibilitytool.vdf")).read())
        return m.group(1) if m else os.path.basename(d)
    except OSError:
        return os.path.basename(d)


def steam_default():
    """config.vdf CompatToolMapping: "0" (all games) and per-game names."""
    try:
        t = open(os.path.join(STEAM_ROOT, "config/config.vdf"), errors="replace").read()
    except OSError:
        return "", {}
    i = t.find('"CompatToolMapping"')
    if i < 0:
        return "", {}
    block = t[i:t.find('"Tools"', i) if '"Tools"' in t[i:] else i + 20000]
    games = dict(re.findall(r'"(\d+)"\s*\{\s*"name"\s*"([^"]*)"', block))
    return games.pop("0", ""), games


def c_tools(args):
    tools = []
    for target, base in TARGETS.items():
        for d in sorted(glob.glob(os.path.join(base, "*"))):
            if os.path.isdir(d):
                tools.append({"target": target, "dir": os.path.basename(d), "name": vdf_name(d) if target != "lutris" else os.path.basename(d),
                              "size": du(d), "latest": os.path.basename(d).endswith(" Latest"), "system": False})
    for d in sorted(glob.glob(os.path.join(SYSTEM_STEAM, "*"))):
        tools.append({"target": "steam", "dir": os.path.basename(d), "name": vdf_name(d), "size": 0, "latest": False, "system": True})
    default, games = steam_default()
    faugus = {}
    try:
        faugus = json.load(open(os.path.join(HOME, ".config/faugus-launcher/config.json")))
    except (OSError, ValueError):
        pass
    out({"tools": tools, "targets": {k: os.path.isdir(v) or (k == "steam" and os.path.isdir(STEAM_ROOT)) for k, v in TARGETS.items()},
         "steamDefault": default, "steamGames": len(games), "steamRunning": bool(sh("pgrep", "-x", "steam").strip()),
         "faugusDefault": faugus.get("default-runner", ""), "accepts": {k: sorted(v) for k, v in ACCEPTS.items()}})


def c_releases(args):
    src = SOURCES.get(args[0])
    if not src:
        sys.exit("unknown source")
    rels = json.loads(fetch(f"https://api.github.com/repos/{src['repo']}/releases?per_page=8"))
    res = []
    for r in rels:
        assets = r.get("assets", [])
        a = next((x for x in assets if re.match(src["asset"], x["name"])), None) or \
            (next((x for x in assets if re.match(src.get("fallback", "^$"), x["name"])), None) if src.get("fallback") else None)
        if a:
            res.append({"tag": r["tag_name"], "date": r.get("published_at", "")[:10], "asset": a["name"], "size": a["size"]})
    out({"source": args[0], "title": src["title"], "latest": src.get("latest", ""), "releases": res})


def safe_extract(tar, dest):
    base = os.path.realpath(dest)
    for m in tar.getmembers():
        p = os.path.realpath(os.path.join(dest, m.name))
        if not (p == base or p.startswith(base + os.sep)) or m.isdev():
            raise SystemExit(f"refusing an unsafe archive entry: {m.name}")
    # the "tar" filter also refuses links to absolute paths or outside dest
    tar.extractall(dest, filter="tar")


def set_vdf_name(d, name):
    """Rename the tool (internal and shown name) so a "Latest" copy keeps one stable name."""
    p = os.path.join(d, "compatibilitytool.vdf")
    try:
        t = open(p).read()
    except OSError:
        return
    t = re.sub(r'("compat_tools"\s*\{\s*)"[^"]+"', rf'\1"{name}"', t, count=1)
    t = re.sub(r'("display_name"\s*)"[^"]+"', rf'\1"{name}"', t, count=1)
    open(p, "w").write(t)


def c_install(args):
    source, tag, target = args[0], args[1], args[2]
    latest = "--latest" in args
    src = SOURCES.get(source)
    if not src or target not in TARGETS or source not in ACCEPTS[target]:
        sys.exit("that tool doesn't go into that launcher")
    rel = json.loads(fetch(f"https://api.github.com/repos/{src['repo']}/releases/tags/{tag}"))
    assets = {a["name"]: a for a in rel.get("assets", [])}
    name = next((n for n in assets if re.match(src["asset"], n)), None) or \
        next((n for n in assets if src.get("fallback") and re.match(src["fallback"], n)), None)
    if not name:
        sys.exit("no download for this system in that release")
    dest = TARGETS[target]
    os.makedirs(dest, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="caelestia-tool-", dir=os.path.join(HOME, ".cache")) as tmp:
        arch = os.path.join(tmp, name)
        print(f"Downloading {name} ({assets[name]['size'] // 1048576} MB)", flush=True)
        req = urllib.request.Request(assets[name]["browser_download_url"], headers={"User-Agent": UA})
        h512, h256 = hashlib.sha512(), hashlib.sha256()
        with urllib.request.urlopen(req, timeout=60) as r, open(arch, "wb") as f:
            done, total, step = 0, assets[name]["size"], 0
            while chunk := r.read(1 << 20):
                f.write(chunk)
                h512.update(chunk)
                h256.update(chunk)
                done += len(chunk)
                if done * 10 // max(total, 1) > step:
                    step = done * 10 // max(total, 1)
                    print(f"Downloaded {done * 100 // max(total, 1)}%", flush=True)
        # Checksum: the release's own sum file
        want = None
        sumname = name.rsplit(".tar", 1)[0] + src["sum"] if src.get("sum") else src.get("sums")
        if sumname in assets:
            text = fetch(assets[sumname]["browser_download_url"]).decode(errors="replace")
            for line in text.splitlines():
                parts = line.split()
                if parts and (len(parts) == 1 or parts[-1].lstrip("*").endswith(name)):
                    want = parts[0].lower()
                    break
        if not want:
            sys.exit("no checksum published for it: not installed")
        got = h512.hexdigest() if len(want) == 128 else h256.hexdigest()
        if got != want:
            sys.exit("the download doesn't match its checksum: not installed")
        print("Checksum OK; unpacking", flush=True)
        unpack = os.path.join(tmp, "x")
        os.makedirs(unpack)
        with tarfile.open(arch) as t:
            safe_extract(t, unpack)
        tops = os.listdir(unpack)
        if len(tops) != 1 or not os.path.isdir(os.path.join(unpack, tops[0])):
            sys.exit("unexpected archive layout")
        top = os.path.join(unpack, tops[0])
        final = os.path.join(dest, src["latest"] if latest and src.get("latest") else tops[0])
        if latest and src.get("latest"):
            set_vdf_name(top, src["latest"])
        if os.path.exists(final):
            shutil.rmtree(final)
        shutil.move(top, final)
    print(f"Installed {os.path.basename(final)} for {target}", flush=True)


def c_remove(args):
    target, name = args[0], args[1]
    base = TARGETS.get(target)
    if not base or "/" in name or name in ("", ".", ".."):
        sys.exit("not an installed version")
    path = os.path.join(base, name)
    if not os.path.isdir(path) or os.path.realpath(path) != path:
        sys.exit("not an installed version")
    if target == "steam":
        users = steam_users(path, name)
        if users:
            sys.exit(f"Steam uses it ({', '.join(users)}): choose another for those in Steam first")
    shutil.rmtree(path)
    print(f"Removed {name}", flush=True)


def steam_users(path, dirname):
    """What in Steam's settings uses this tool (its default, games by app id)."""
    names = {dirname}
    try:
        m = re.search(r'"compat_tools"\s*\{\s*"([^"]+)"', open(os.path.join(path, "compatibilitytool.vdf"), errors="replace").read())
        if m:
            names.add(m.group(1))
    except OSError:
        pass
    try:
        t = open(os.path.join(STEAM_ROOT, "config/config.vdf"), errors="replace").read()
    except OSError:
        return []
    i = t.find('"CompatToolMapping"')
    if i < 0:
        return []
    users = []
    for m in re.finditer(r'"(\d+)"\s*\{\s*"name"\s*"([^"]*)"', t[i:i + 200000]):
        if m.group(2) in names:
            users.append("its default" if m.group(1) == "0" else f"game {m.group(1)}")
    return users


def c_set_default(args):
    target, name = args[0], args[1]
    if not re.fullmatch(r"[A-Za-z0-9 ._()+-]{1,80}", name):
        sys.exit("not a tool name")
    if target == "steam":
        if sh("pgrep", "-x", "steam").strip():
            sys.exit("close Steam first (it rewrites its settings when it exits)")
        p = os.path.join(STEAM_ROOT, "config/config.vdf")
        t = open(p, errors="replace").read()
        i = t.find('"CompatToolMapping"')
        if i < 0:
            sys.exit("Steam hasn't set up its compatibility settings yet (choose one in Steam once)")
        m = re.compile(r'("0"\s*\{\s*"name"\s*)"[^"]*"').search(t, i)
        if not m:
            sys.exit("Steam has no default compatibility tool set yet (choose one in Steam once)")
        t = t[:m.start()] + m.group(1) + f'"{name}"' + t[m.end():]
        shutil.copy2(p, p + ".caelestia-bak")
        open(p, "w").write(t)
    elif target == "faugus":
        p = os.path.join(HOME, ".config/faugus-launcher/config.json")
        d = json.load(open(p))
        d["default-runner"] = name
        json.dump(d, open(p, "w"), indent=4)
    else:
        sys.exit("that launcher's default is chosen in the launcher")
    print(f"Default for {target}: {name}", flush=True)


# --- MangoHud ----------------------------------------------------------------------------

MANGO = os.path.join(HOME, ".config/MangoHud/MangoHud.conf")
MANGO_KEY = re.compile(r"^[a-z_0-9]+$")
# Shown unless turned off explicitly (MangoHud's defaults): off is written as =0
MANGO_DEFAULT_ON = {"fps", "frame_timing", "cpu_stats", "gpu_stats", "text_outline"}


def c_mangohud(args):
    opts = {}
    try:
        for line in open(MANGO):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            k, _, v = line.partition("=")
            k, v = k.strip(), v.strip()
            opts[k] = (False if v == "0" and k in MANGO_DEFAULT_ON else v) if _ else True
    except OSError:
        pass
    out({"file": MANGO, "exists": os.path.exists(MANGO), "options": opts})


def c_mangohud_set(args):
    opts = json.loads(sys.stdin.read() or "{}")
    lines = ["# MangoHud: written by Settings › Gaming › Overlay (other options you add are kept)"]
    for k, v in opts.items():
        if not MANGO_KEY.match(k):
            sys.exit(f"not an option name: {k}")
        if v is True:
            lines.append(k)
        elif v is False or v is None:
            if k in MANGO_DEFAULT_ON and v is False:
                lines.append(f"{k}=0")
            continue
        else:
            v = str(v)
            if "\n" in v or len(v) > 200:
                sys.exit("not allowed in a value")
            lines.append(f"{k}={v}")
    os.makedirs(os.path.dirname(MANGO), exist_ok=True)
    tmp = MANGO + ".tmp"
    open(tmp, "w").write("\n".join(lines) + "\n")
    os.replace(tmp, MANGO)
    c_mangohud([])


# --- CPU scheduler (sched-ext) ---------------------------------------------------------------

def c_scx(args):
    # The loader is D-Bus activated (running doesn't mean set up): enabled =
    # starts the configured scheduler at boot
    enabled = sh("systemctl", "is-enabled", "scx_loader.service").strip() == "enabled"
    active = sh("systemctl", "is-active", "scx_loader.service").strip() == "active"
    current = sh("scxctl", "get").strip() if active else ""
    # "supported schedulers: ["beerland", ...]" (scxctl list), else what's installed
    names = re.findall(r'"([a-z0-9_]+)"', sh("scxctl", "list")) if active else []
    avail = sorted("scx_" + n if not n.startswith("scx_") else n for n in names) or \
        sorted(os.path.basename(p) for p in glob.glob("/usr/bin/scx_*") if os.path.basename(p) not in ("scx_loader",))
    conf = {}
    for p in ("/etc/scx_loader/config.toml", "/etc/scx_loader.toml"):
        if os.path.exists(p):
            for line in open(p):
                m = re.match(r'^\s*(default_sched|default_mode)\s*=\s*"([^"]*)"', line)
                if m:
                    conf[m.group(1)] = m.group(2)
            break
    try:
        state = open("/sys/kernel/sched_ext/state").read().strip()
    except OSError:
        state = "unsupported"
    out({"loader": enabled, "loaderActive": active, "current": current, "available": avail, "config": conf, "kernelState": state,
         "ananicy": sh("systemctl", "is-active", "ananicy-cpp.service").strip() == "active",
         "gamemode": shutil.which("gamemoderun") is not None})


# --- games: every launcher's library, per-game settings ---------------------------------
#
# Each game's own settings live where its launcher keeps them (so the launcher
# shows the same): Steam: Proton in config.vdf CompatToolMapping, options and
# wrappers in the user's localconfig.vdf LaunchOptions ("KEY=1 mangohud
# %command%"); Lutris: games/<configpath>.yml (wine.version, system.env,
# system.mangohud, system.prefix_command); Faugus: games.json (runner,
# launch_arguments, mangohud); Heroic: GamesConfig/<app>.json (wineVersion,
# enviromentOptions, showMangohud, wrapperOptions). Only the options the page
# offers (ENV_KEYS) and its two wrappers are changed; anything else is kept.
# Steam, Faugus and Heroic rewrite their files from memory: changed only while
# they're closed.

PERF = "game-performance"
VDF_TOK = re.compile(r'\s*(?://[^\n]*\n\s*)*(?:"((?:[^"\\]|\\.)*)"|([{}]))')


def vdf_load(text):
    """Steam's text VDF as [[key, value or [children]]], strings raw (as written)."""
    pos = 0

    def parse(depth):
        nonlocal pos
        items = []
        while True:
            m = VDF_TOK.match(text, pos)
            if not m:
                if depth:
                    raise ValueError("unterminated block")
                return items
            if m.group(2) == "}":
                pos = m.end()
                return items
            if m.group(2) == "{":
                raise ValueError("unexpected {")
            key = m.group(1)
            pos = m.end()
            m2 = VDF_TOK.match(text, pos)
            if not m2:
                raise ValueError("no value for " + key)
            pos = m2.end()
            if m2.group(2) == "{":
                items.append([key, parse(depth + 1)])
            elif m2.group(1) is not None:
                items.append([key, m2.group(1)])
            else:
                raise ValueError("unexpected }")
    return parse(0)


def vdf_dump(items, depth=0):
    """Back to text, as Steam writes it (a file read and written unchanged is byte-identical)."""
    ind = "\t" * depth
    res = []
    for k, v in items:
        if isinstance(v, list):
            res.append(f'{ind}"{k}"\n{ind}{{\n{vdf_dump(v, depth + 1)}{ind}}}\n')
        else:
            res.append(f'{ind}"{k}"\t\t"{v}"\n')
    return "".join(res)


def vdf_find(items, *keys, create=False):
    for key in keys:
        node = next((v for k, v in items if k.lower() == key.lower() and isinstance(v, list)), None)
        if node is None:
            if not create:
                return None
            node = []
            items.append([key, node])
        items = node
    return items


def vdf_get(items, key, default=""):
    v = next((v for k, v in items if k.lower() == key.lower() and not isinstance(v, list)), None)
    return default if v is None else v.replace('\\"', '"').replace("\\\\", "\\")


def vdf_set(items, key, value):
    raw = value.replace("\\", "\\\\").replace('"', '\\"')
    for it in items:
        if it[0].lower() == key.lower() and not isinstance(it[1], list):
            it[1] = raw
            return
    items.append([key, raw])


def vdf_read(path):
    return vdf_load(open(path, encoding="utf-8", errors="surrogateescape").read())


def vdf_write(path, items):
    shutil.copy2(path, path + ".caelestia-bak")
    tmp = path + ".caelestia-tmp"
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.write(vdf_dump(items))
    os.replace(tmp, path)


SHELL_WORD = re.compile(r"""(?:[^\s'"\\]+|'[^']*'|"(?:[^"\\]|\\.)*"|\\.)+""")


def shell_words(text):
    """[(raw, value)]: each word as written and as the shell reads it."""
    res = []
    for m in SHELL_WORD.finditer(text):
        raw = m.group(0)
        try:
            val = shlex.split(raw)[0] if raw else ""
        except (ValueError, IndexError):
            val = raw
        res.append((raw, val))
    return res


def split_launch(opts):
    """Launch options -> (env [(k, v, raw)], wrappers [(raw, value)], after): "K=1 mangohud %command% -dx11".
    Words are kept as written (a rewrite changes only what the page changed)."""
    if "%command%" in opts:
        before, after = opts.split("%command%", 1)
    else:
        before, after = "", opts
    env, wrappers = [], []
    for raw, val in shell_words(before):
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", val, re.S)
        if m and not wrappers:
            env.append((m.group(1), m.group(2), raw))
        else:
            wrappers.append((raw, val))
    return env, wrappers, after.strip()


def join_launch(env, wrappers, after):
    if not env and not wrappers:
        return after
    parts = [raw if raw else f"{k}={shlex.quote(v)}" for k, v, raw in env] + [raw for raw, _ in wrappers] + ["%command%"]
    return " ".join(parts + ([after] if after else []))


def apply_env(pairs, changes):
    """pairs [(k, v, raw)] with changes {K: value or None (remove)}: order kept, new ones last;
    a changed one loses its raw text (written anew)."""
    res = []
    for k, v, raw in pairs:
        if k in changes:
            if changes[k] is not None:
                res.append((k, changes[k], "" if changes[k] != v else raw))
        else:
            res.append((k, v, raw))
    have = {k for k, _, _ in pairs}
    res += [(k, v, "") for k, v in changes.items() if k not in have and v is not None]
    return res


def check_changes(req):
    env = req.get("env") or {}
    for k, v in env.items():
        if k == "WINEDLLOVERRIDES":  # set by the MFG unlock (its DLL next to the game)
            if v is not None and not OVERRIDES_VALUE.match(str(v)):
                sys.exit("not allowed in a value")
            continue
        if k not in ENV_KEYS:
            sys.exit(f"not an option here: {k}")
        if v is not None and not VALUE.match(str(v)):
            sys.exit("not allowed in a value")
    proton = req.get("proton")
    if proton is not None and not re.fullmatch(r"[A-Za-z0-9 ._()+/-]{0,200}", proton):
        sys.exit("not a version name")
    return {k: (None if v is None else str(v)) for k, v in env.items()}, proton


def running(*names):
    for n in names:
        if sh("pgrep", "-x", n).strip():
            return True
    return False


def faugus_running():
    for p in sh("pgrep", "-a", "python3").splitlines():
        if re.search(r"-m faugus\.(launcher|tray_only)\b", p) or p.rstrip().endswith("/faugus-launcher"):
            return True
    return bool(sh("pgrep", "-x", "faugus-launcher").strip())


def file_mtime(p):
    try:
        return os.stat(p).st_mtime
    except OSError:
        return 0


# Steam ------------------------------------------------------------------------------

STEAM_TOOLS = {"228980"}  # Steamworks Common Redistributables


def steam_libraries():
    libs = [STEAM_ROOT]
    try:
        for k, v in vdf_find(vdf_read(os.path.join(STEAM_ROOT, "steamapps/libraryfolders.vdf")), "libraryfolders") or []:
            if isinstance(v, list):
                p = vdf_get(v, "path")
                if p and os.path.realpath(p) not in [os.path.realpath(x) for x in libs]:
                    libs.append(p)
    except (OSError, ValueError):
        pass
    return [l for l in libs if os.path.isdir(os.path.join(l, "steamapps"))]


def steam_user():
    """userdata/<account id> of the last signed-in user."""
    try:
        users = vdf_find(vdf_read(os.path.join(STEAM_ROOT, "config/loginusers.vdf")), "users") or []
        best = next((k for k, v in users if isinstance(v, list) and vdf_get(v, "MostRecent") == "1"), users[0][0] if users else None)
        if best:
            d = os.path.join(STEAM_ROOT, "userdata", str(int(best) - 76561197960265728))
            if os.path.isdir(d):
                return d
    except (OSError, ValueError, IndexError):
        pass
    dirs = [d for d in glob.glob(os.path.join(STEAM_ROOT, "userdata/*")) if os.path.basename(d).isdigit() and os.path.basename(d) != "0"]
    return max(dirs, key=file_mtime) if dirs else None


def steam_official(name):
    """Valve's Proton builds by their internal name (CompatToolMapping)."""
    if name == "Proton Experimental":
        return "proton_experimental"
    if name == "Proton Hotfix":
        return "proton_hotfix"
    m = re.fullmatch(r"Proton (\d+)\.\d+", name)
    return f"proton_{m.group(1)}" if m else None


def steam_manifests():
    for lib in steam_libraries():
        for f in glob.glob(os.path.join(lib, "steamapps/appmanifest_*.acf")):
            try:
                st = vdf_find(vdf_read(f), "AppState")
            except (OSError, ValueError):
                continue
            if st:
                yield lib, st


def steam_cover(appid):
    base = os.path.join(STEAM_ROOT, "appcache/librarycache", appid)
    for pat in ("library_600x900.jpg", "*/library_600x900.jpg", "library_capsule.jpg", "*/library_capsule.jpg",
                "header.jpg", "*/header.jpg"):
        hit = sorted(glob.glob(os.path.join(base, pat)))
        if hit:
            return hit[0]
    old = os.path.join(STEAM_ROOT, f"appcache/librarycache/{appid}_library_600x900.jpg")
    return old if os.path.exists(old) else ""


# Steam's non-Steam games (userdata/<user>/config/shortcuts.vdf): binary VDF.
# 0x00 map, 0x01 string, 0x02 int32, 0x08 end; strings are NUL-terminated.

def bvdf_load(data):
    pos = 0

    def cstr():
        nonlocal pos
        end = data.index(b"\x00", pos)
        v = data[pos:end].decode("utf-8", "surrogateescape")
        pos = end + 1
        return v

    def parse():
        nonlocal pos
        items = []
        while True:
            t = data[pos]
            pos += 1
            if t == 0x08:
                return items
            key = cstr()
            if t == 0x00:
                items.append([key, parse()])
            elif t == 0x01:
                items.append([key, cstr()])
            elif t == 0x02:
                items.append([key, ("i32", struct.unpack_from("<i", data, pos)[0])])
                pos += 4
            else:
                raise ValueError(f"unknown value type {t}")
    items = parse() if data else []
    return items


def bvdf_dump(items):
    out_ = bytearray()
    for k, v in items:
        kb = k.encode("utf-8", "surrogateescape") + b"\x00"
        if isinstance(v, list):
            out_ += b"\x00" + kb + bvdf_dump(v)
        elif isinstance(v, tuple):
            out_ += b"\x02" + kb + struct.pack("<i", v[1])
        else:
            out_ += b"\x01" + kb + v.encode("utf-8", "surrogateescape") + b"\x00"
    return bytes(out_ + b"\x08")


def shortcuts_path(user):
    return os.path.join(user, "config/shortcuts.vdf")


def shortcuts_load(user):
    p = shortcuts_path(user)
    if not os.path.exists(p):
        return [["shortcuts", []]]
    # The file: \x00shortcuts\x00 <entries> \x08 (the map's end) \x08 (the file's end)
    items = bvdf_load(open(p, "rb").read())
    return items if items else [["shortcuts", []]]


def shortcuts_save(user, items):
    p = shortcuts_path(user)
    if os.path.exists(p):
        shutil.copy2(p, p + ".caelestia-bak")
    tmp = p + ".caelestia-tmp"
    with open(tmp, "wb") as f:
        f.write(bvdf_dump(items))
    os.replace(tmp, p)


def sc_get(entry, key, default=""):
    v = next((v for k, v in entry if k.lower() == key.lower()), None)
    if v is None:
        return default
    return v[1] if isinstance(v, tuple) else v


def sc_set(entry, key, value):
    for it in entry:
        if it[0].lower() == key.lower():
            it[1] = value
            return
    entry.append([key, value])


def sc_appid(entry):
    return sc_get(entry, "appid", 0) & 0xFFFFFFFF


WINDOWS_EXE = re.compile(r"\.(exe|bat|msi|lnk)\"?$", re.I)


def steam_shortcut_games(user, mapping):
    games = []
    try:
        sc = vdf_find_b(shortcuts_load(user))
    except (OSError, ValueError, IndexError, struct.error):
        return games
    for _, entry in sc:
        if not isinstance(entry, list):
            continue
        appid = str(sc_appid(entry))
        exe = sc_get(entry, "Exe")
        env, wrappers, after = split_launch(sc_get(entry, "LaunchOptions"))
        cover = next((c for ext in ("png", "jpg") for c in [os.path.join(user, f"config/grid/{appid}p.{ext}")] if os.path.exists(c)), "")
        windows = bool(WINDOWS_EXE.search(exe.strip()))
        games.append({"key": f"steam:{appid}", "launcher": "steam", "id": appid, "title": sc_get(entry, "AppName") or exe,
                      "cover": cover, "proton": mapping.get(appid, "") if windows else None,
                      "env": {k: v for k, v, _ in env if k in ENV_KEYS},
                      "otherEnv": [raw for k, _, raw in env if k not in ENV_KEYS],
                      "mangohud": "mangohud" in [v for _, v in wrappers], "perf": PERF in [v for _, v in wrappers],
                      "wrappers": [raw for raw, v in wrappers if v not in ("mangohud", PERF)], "args": after,
                      "launchOptions": sc_get(entry, "LaunchOptions"), "size": 0,
                      "lastPlayed": sc_get(entry, "LastPlayTime", 0) or 0, "state": "installed", "shortcut": True,
                      "path": exe.strip('"'),
                      "play": ["steam", f"steam://rungameid/{(int(appid) << 32) | 0x02000000}"], "removable": True})
    return games


def vdf_find_b(items):
    """The list of shortcuts in a loaded shortcuts.vdf."""
    node = next((v for k, v in items if k.lower() == "shortcuts" and isinstance(v, list)), None)
    if node is None:
        node = []
        items.append(["shortcuts", node])
    return node


def steam_games():
    games, choices = [], [["", "Steam's default"]]
    mapping = {}
    try:
        m = vdf_find(vdf_read(os.path.join(STEAM_ROOT, "config/config.vdf")),
                     "InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping") or []
        mapping = {k: vdf_get(v, "name") for k, v in m if isinstance(v, list)}
    except (OSError, ValueError):
        pass
    apps = {}
    user = steam_user()
    if user:
        try:
            a = vdf_find(vdf_read(os.path.join(user, "config/localconfig.vdf")),
                         "UserLocalConfigStore", "Software", "Valve", "Steam", "apps") or []
            apps = {k: v for k, v in a if isinstance(v, list)}
        except (OSError, ValueError):
            pass
    for d in sorted(glob.glob(os.path.join(TARGETS["steam"], "*")) + glob.glob(os.path.join(SYSTEM_STEAM, "*"))):
        if os.path.isdir(d):
            choices.append([vdf_name(d), vdf_name(d)])
    for lib, st in steam_manifests():
        appid, name = vdf_get(st, "appid"), vdf_get(st, "name")
        installdir = vdf_get(st, "installdir")
        if appid in STEAM_TOOLS or os.path.exists(os.path.join(lib, "steamapps/common", installdir, "toolmanifest.vdf")):
            off = steam_official(name)
            if off:
                choices.append([off, name])
            continue
        if name.startswith("Steam Linux Runtime"):
            continue
        app = apps.get(appid, [])
        opts = vdf_get(app, "LaunchOptions")
        env, wrappers, after = split_launch(opts)
        flags = int(vdf_get(st, "StateFlags", "0") or 0)
        games.append({"key": f"steam:{appid}", "launcher": "steam", "id": appid, "title": name,
                      "cover": steam_cover(appid), "proton": mapping.get(appid, ""),
                      "env": {k: v for k, v, _ in env if k in ENV_KEYS},
                      "otherEnv": [raw for k, _, raw in env if k not in ENV_KEYS],
                      "mangohud": "mangohud" in [v for _, v in wrappers], "perf": PERF in [v for _, v in wrappers],
                      "wrappers": [raw for raw, v in wrappers if v not in ("mangohud", PERF)], "args": after,
                      "launchOptions": opts, "size": int(vdf_get(st, "SizeOnDisk", "0") or 0),
                      "lastPlayed": int(vdf_get(app, "LastPlayed", "0") or vdf_get(st, "LastPlayed", "0") or 0),
                      "state": "installed" if flags == 4 else "updating",
                      "path": os.path.join(lib, "steamapps/common", installdir),
                      "play": ["steam", f"steam://rungameid/{appid}"], "removable": False})
    if user:
        games += steam_shortcut_games(user, mapping)
    return games, {"installed": os.path.isdir(STEAM_ROOT), "running": running("steam"), "choices": choices,
                   "default": steam_default()[0], "perf": True, "user": bool(user)}


def steam_set(appid, req):
    env_changes, proton = check_changes(req)
    if running("steam"):
        sys.exit("close Steam first (it rewrites its settings when it quits)")
    if proton is not None:
        p = os.path.join(STEAM_ROOT, "config/config.vdf")
        t = vdf_read(p)
        m = vdf_find(t, "InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping", create=True)
        entry = next((v for k, v in m if k == appid and isinstance(v, list)), None)
        if not proton:
            m[:] = [it for it in m if it[0] != appid]
        elif entry is not None:
            vdf_set(entry, "name", proton)
        else:
            m.append([appid, [["name", proton], ["config", ""], ["priority", "250"]]])
        vdf_write(p, t)
    if env_changes or "mangohud" in req or "perf" in req:
        user = steam_user()
        if not user:
            sys.exit("no Steam user found (sign in to Steam once)")
        items = shortcuts_load(user)
        entry = next((e for _, e in vdf_find_b(items) if isinstance(e, list) and str(sc_appid(e)) == appid), None)
        if entry is not None:  # a non-Steam game: its own launch options
            env, wrappers, after = split_launch(sc_get(entry, "LaunchOptions"))
            env = apply_env(env, env_changes)
            for name, key in (("mangohud", "mangohud"), (PERF, "perf")):
                if key in req:
                    wrappers = [w for w in wrappers if w[1] != name]
                    if req[key]:
                        wrappers.insert(0, (name, name))
            sc_set(entry, "LaunchOptions", join_launch(env, wrappers, after))
            shortcuts_save(user, items)
            return
        p = os.path.join(user, "config/localconfig.vdf")
        t = vdf_read(p)
        app = vdf_find(t, "UserLocalConfigStore", "Software", "Valve", "Steam", "apps", appid, create=True)
        env, wrappers, after = split_launch(vdf_get(app, "LaunchOptions"))
        env = apply_env(env, env_changes)
        for name, key in (("mangohud", "mangohud"), (PERF, "perf")):
            if key in req:
                wrappers = [w for w in wrappers if w[1] != name]
                if req[key]:
                    wrappers.insert(0, (name, name))
        vdf_set(app, "LaunchOptions", join_launch(env, wrappers, after))
        vdf_write(p, t)


