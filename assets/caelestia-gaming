def env_file():
    """The environment.d file already holding game options, else gaming.conf."""
    best = os.path.join(ENVD, "gaming.conf")
    for f in sorted(glob.glob(os.path.join(ENVD, "*.conf"))):
        try:
            text = open(f).read()
        except OSError:
            continue
        if any(re.search(rf"^\s*{k}=", text, re.M) for k in ENV_KEYS):
            return f
    return best


def read_env(path):
    vals = {}
    try:
        for line in open(path):
            m = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
            if m:
                vals[m.group(1)] = m.group(2).strip().strip('"')
    except OSError:
        pass
    return vals


def c_env(args):
    path = env_file()
    out({"file": path, "exists": os.path.exists(path), "values": read_env(path)})


VALUE = re.compile(r"^[A-Za-z0-9_.,=:/@+ -]{0,400}$")
OVERRIDES_VALUE = re.compile(r"^[A-Za-z0-9_.,=;*-]{0,400}$")


def c_env_set(args):
    key, val = args[0], args[1]
    if key not in ENV_KEYS:
        sys.exit(f"not an option here: {key}")
    if val != "--unset" and not VALUE.match(val):
        sys.exit("not allowed in a value")
    path = env_file()
    os.makedirs(ENVD, exist_ok=True)
    lines = open(path).read().split("\n") if os.path.exists(path) else [
        "# Games: options for Proton, DXVK and the NVIDIA driver (Settings › Gaming; applies after logging in again)"]
    lines = [l for l in lines if not re.match(rf"^\s*{key}=", l)]
    if val != "--unset":
        while lines and not lines[-1].strip():
            lines.pop()
        lines.append(f"{key}={val}")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines).rstrip("\n") + "\n")
    os.replace(tmp, path)
    out({"file": path, "values": read_env(path)})


