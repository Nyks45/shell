def c_popular(args):
    fl = flatpak_installed()
    aur_names = [n for _, _, items in POPULAR for s, n in items if s == "aur"]
    try:
        aur = aur_info(aur_names)
    except Exception:
        aur = {}
    # Flathub names/descriptions, asked in parallel (each is a flatpak call)
    def remote_info(name):
        for line in [l for l in sh("flatpak", "remote-info", "--cached", "flathub", name, timeout=10).splitlines() if l.strip()][:1]:
            if " - " in line:
                n, d = (x.strip() for x in line.split(" - ", 1))
                return name, {"name": n, "desc": d}
        return name, {}
    fl_names = [n for _, _, items in POPULAR for s, n in items if s == "flatpak"]
    with cf.ThreadPoolExecutor(8) as ex:
        fl_info = dict(ex.map(remote_info, fl_names))
    cats = []
    for title, icon, items in POPULAR:
        entries = []
        for source, name in items:
            if source == "repo":
                p = sync_pkg(name)
                if p:
                    entries.append(repo_item(p))
            elif source == "aur":
                r = aur.get(name)
                lp = local().get_pkg(name)
                if r:
                    entries.append(aur_item(r))
                elif lp:
                    entries.append({"source": "aur", "name": name, "version": lp.version, "desc": lp.desc or "",
                                    "installed": True, "installedVersion": lp.version})
            else:
                info = fl_info.get(name, {})
                entries.append({"source": "flatpak", "appId": name, "name": info.get("name") or fl.get(name, {}).get("name") or name.split(".")[-1],
                                "desc": info.get("desc", ""), "installed": name in fl, "icon": flatpak_icon(name),
                                "installedVersion": fl.get(name, {}).get("version", "")})
        cats.append({"title": title, "icon": icon, "items": entries})
    out(cats)


def restart_needed():
    """Running kernel's modules gone (a kernel update) or the NVIDIA driver changed under it."""
    reasons = []
    rel = os.uname().release
    if not os.path.isdir(f"/usr/lib/modules/{rel}"):
        reasons.append("kernel")
    try:
        loaded = re.search(r"Kernel Module(?: for x86_64)?\s+([\d.]+)", open("/proc/driver/nvidia/version").read())
        lp = local().get_pkg("nvidia-utils")
        if loaded and lp and not lp.version.startswith(loaded.group(1)):
            reasons.append("nvidia")
    except OSError:
        pass
    return reasons


def c_restart(args):
    out({"reasons": restart_needed()})


def parse_updates(text):
    res = []
    for line in text.splitlines():
        m = re.match(r"^(\S+)\s+(\S+)\s+->\s+(\S+)", line)
        if m:
            res.append({"name": m.group(1), "from": m.group(2), "to": m.group(3)})
    return res


def c_updates(args):
    result = {"repo": [], "aur": [], "flatpak": [], "errors": {}, "restart": restart_needed(),
              "held": pacman_conf()[0].get("IgnorePkg", "").split()}

    def repo():
        return parse_updates(sh("checkupdates", timeout=120))

    def aur():
        return parse_updates(sh("paru", "-Qua", timeout=120)) if os.path.exists("/usr/bin/paru") else []

    def flat():
        inst = flatpak_installed()
        res = []
        for line in sh("flatpak", "remote-ls", "--updates", "--columns=application,version", timeout=120).splitlines():
            f = line.split("\t")
            if f and f[0]:
                res.append({"name": inst.get(f[0], {}).get("name") or f[0], "appId": f[0],
                            "from": inst.get(f[0], {}).get("version", ""), "to": f[1] if len(f) > 1 else ""})
        return res

    with cf.ThreadPoolExecutor(3) as ex:
        futs = {ex.submit(repo): "repo", ex.submit(aur): "aur", ex.submit(flat): "flatpak"}
        for fut in cf.as_completed(futs):
            try:
                result[futs[fut]] = fut.result()
            except Exception as e:
                result["errors"][futs[fut]] = str(e)
    out(result)


def c_news(args):
    items = []
    try:
        root = ET.fromstring(fetch("https://archlinux.org/feeds/news/"))
        for it in root.iter("item"):
            desc = re.sub(r"<[^>]+>", " ", html.unescape(it.findtext("description") or ""))
            items.append({"title": it.findtext("title") or "", "link": it.findtext("link") or "",
                          "date": it.findtext("pubDate") or "", "summary": re.sub(r"\s+", " ", desc).strip()[:400]})
    except Exception as e:
        out({"items": [], "error": str(e)})
        return
    out({"items": items[:8]})


def c_pacnew(args):
    found = []
    for dirpath, dirs, files in os.walk("/etc", onerror=lambda e: None):
        for f in files:
            if f.endswith((".pacnew", ".pacsave")):
                p = os.path.join(dirpath, f)
                orig = p.rsplit(".", 1)[0]
                try:
                    mtime = os.stat(p).st_mtime
                except OSError:
                    mtime = 0
                found.append({"path": p, "original": orig, "kind": p.rsplit(".", 1)[1],
                              "originalExists": os.path.exists(orig), "date": int(mtime),
                              "readable": os.access(p, os.R_OK) and (not os.path.exists(orig) or os.access(orig, os.R_OK))})
    found.sort(key=lambda x: -x["date"])
    out(found)


def c_pacdiff(args):
    p = os.path.realpath(args[0])
    if not p.startswith("/etc/") or not p.endswith((".pacnew", ".pacsave")):
        sys.exit("not a .pacnew/.pacsave under /etc")
    orig = p.rsplit(".", 1)[0]
    try:
        new = open(p, errors="replace").read().splitlines()
        old = open(orig, errors="replace").read().splitlines() if os.path.exists(orig) else []
    except OSError as e:
        out({"error": str(e)})
        return
    diff = list(difflib.unified_diff(old, new, orig, p, lineterm="", n=2))
    out({"diff": "\n".join(diff[:800]), "truncated": len(diff) > 800})


def cache_dirs():
    return pacman_conf()[0].get("CacheDir", "/var/cache/pacman/pkg/").split()


def c_versions(args):
    name = args[0]
    lp = local().get_pkg(name)
    vers = []
    for d in cache_dirs():
        for f in glob.glob(os.path.join(d, f"{glob.escape(name)}-*.pkg.tar.*")):
            base = os.path.basename(f)
            if base.endswith(".sig"):
                continue
            stem = re.sub(r"\.pkg\.tar\.\w+$", "", base)
            parts = stem.rsplit("-", 3)
            if len(parts) == 4 and parts[0] == name:
                ver = f"{parts[1]}-{parts[2]}"
                vers.append({"version": ver, "file": f, "current": bool(lp and lp.version == ver),
                             "date": int(os.stat(f).st_mtime)})
    vers.sort(key=functools.cmp_to_key(lambda a, b: pyalpm.vercmp(b["version"], a["version"])))
    out({"installed": lp.version if lp else "", "versions": vers})


def c_holds(args):
    opts = pacman_conf()[0]
    out({"packages": opts.get("IgnorePkg", "").split(), "groups": opts.get("IgnoreGroup", "").split()})


COMMANDS = {"search": c_search, "info": c_info, "installed": c_installed, "popular": c_popular, "updates": c_updates,
            "news": c_news, "pacnew": c_pacnew, "pacdiff": c_pacdiff, "versions": c_versions, "holds": c_holds,
            "restart": c_restart}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        return COMMANDS[argv[0]](argv[1:]) or 0
    except IndexError:
        print(f"usage: see caelestia-packages --help ({argv[0]})", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
